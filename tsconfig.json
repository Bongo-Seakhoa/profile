{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*.ts",
    "*.config.mjs",
    "*.config.ts"
  ],
  "exclude": ["dist", "node_modules", "playwright-report", "test-results"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
