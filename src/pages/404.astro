---
import ContentStyles from "../components/content/ContentStyles.astro";
import ActionLink from "../components/primitives/ActionLink.astro";
import Container from "../components/primitives/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadProfileContent } from "../lib/content/load-content";

const content = await loadProfileContent();
const route = content.routes.find((entry) => entry.id === "not-found");

if (!route) throw new Error("404 route content is missing.");
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath="404.html"
  noIndex
  pageClass="not-found-page"
>
  <ContentStyles />
  <section class="not-found" aria-labelledby="not-found-title">
    <Container size="content">
      <p class="not-found__code">404</p>
      <h1 id="not-found-title">{route.title}</h1>
      <p>
        The requested portfolio route does not exist. Use one of the direct
        paths below to continue.
      </p>
      <div class="not-found__actions">
        <ActionLink href="">Return to overview</ActionLink>
        <ActionLink href="work/" variant="secondary">Selected work</ActionLink>
        <ActionLink href="documents/" variant="secondary">
          Resume and CV
        </ActionLink>
        <ActionLink href="contact/" variant="quiet">Contact</ActionLink>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(5rem, 14vw, 10rem);
    text-align: center;
  }

  .not-found__code {
    color: var(--rust-strong);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  h1 {
    margin-block-start: var(--space-3);
    font-size: var(--step-4);
  }

  section p:not(.not-found__code) {
    max-inline-size: 52ch;
    margin: var(--space-4) auto 0;
    color: var(--ink-soft);
    font-size: var(--step-1);
  }

  .not-found__actions {
    display: flex;
    margin-block-start: var(--space-6);
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
