---
import ContentStyles from "../../../components/content/ContentStyles.astro";
import ProjectCard from "../../../components/content/ProjectCard.astro";
import StatusBadge from "../../../components/content/StatusBadge.astro";
import TechnologyList from "../../../components/content/TechnologyList.astro";
import ActionLink from "../../../components/primitives/ActionLink.astro";
import Container from "../../../components/primitives/Container.astro";
import MetadataList from "../../../components/primitives/MetadataList.astro";
import PageMasthead from "../../../components/primitives/PageMasthead.astro";
import SectionIntro from "../../../components/primitives/SectionIntro.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { loadProfileContent } from "../../../lib/content/load-content";
import type { Methodology, Project } from "../../../lib/content/schemas";

export async function getStaticPaths() {
  const content = await loadProfileContent();

  const projectPaths = content.projects.map((project) => {
    const route = content.routes.find(
      (entry) =>
        entry.entityRef?.collection === "project" &&
        entry.entityRef.id === project.id,
    );
    if (!route) throw new Error(`Project route missing for ${project.id}`);

    return {
      params: { slug: project.slug },
      props: { content, record: project, recordKind: "project", route },
    };
  });

  const methodologyPaths = content.methodologies.map((methodology) => {
    const route = content.routes.find(
      (entry) =>
        entry.entityRef?.collection === "methodology" &&
        entry.entityRef.id === methodology.id,
    );
    if (!route) {
      throw new Error(`Methodology route missing for ${methodology.id}`);
    }

    return {
      params: { slug: methodology.slug },
      props: {
        content,
        record: methodology,
        recordKind: "methodology",
        route,
      },
    };
  });

  return [...projectPaths, ...methodologyPaths];
}

const { content, record, recordKind, route } = Astro.props as {
  content: Awaited<ReturnType<typeof loadProfileContent>>;
  record: Project | Methodology;
  recordKind: "project" | "methodology";
  route: Awaited<ReturnType<typeof loadProfileContent>>["routes"][number];
};
const settings = content.siteSettings[0];
if (!settings) throw new Error("Site settings are missing.");
const isMethodology = recordKind === "methodology";
const project = isMethodology ? null : (record as Project);
const methodology = isMethodology ? (record as Methodology) : null;
const statusLabel = isMethodology
  ? "Delivery methodology"
  : project?.status === "professional"
    ? "Professional system"
    : project?.status === "experiment"
      ? "Experiment"
      : project?.status === "archived"
        ? "Archived project"
        : "Public project";
const statusTone = isMethodology
  ? "public"
  : project?.status === "archived"
    ? "historical"
    : (project?.status ?? "public");
const recordHost = new URL(record.publicUrl).hostname.toLocaleLowerCase("en");
const sourceLabel = isMethodology
  ? "Public repository"
  : project?.status === "archived"
    ? "Portfolio record"
    : recordHost === "github.com"
      ? "GitHub repository"
      : "Company website";
const externalLinkLabel =
  recordHost === "github.com" ? "View repository" : "Visit organisation";
const ownership = isMethodology ? methodology?.ownership : project?.role;
const practices = isMethodology
  ? (methodology?.practices ?? [])
  : (project?.contributions ?? []);
const recordMetadata = [
  { term: "Status", value: statusLabel },
  { term: "Source", value: sourceLabel },
  ...(ownership
    ? [
        {
          term: isMethodology ? "Method ownership" : "Role",
          value: ownership,
        },
      ]
    : []),
];
const relatedProjects = content.projects
  .filter((entry) => entry.id !== project?.id)
  .filter((entry) => entry.status !== "archived")
  .sort((left, right) => {
    if (left.featured !== right.featured) return left.featured ? -1 : 1;

    const featuredOrderDifference =
      (left.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
      (right.featuredOrder ?? Number.MAX_SAFE_INTEGER);
    if (featuredOrderDifference !== 0) return featuredOrderDifference;

    const leftOverlap = left.technologies.filter((technology) =>
      record.technologies.includes(technology),
    ).length;
    const rightOverlap = right.technologies.filter((technology) =>
      record.technologies.includes(technology),
    ).length;
    return rightOverlap - leftOverlap;
  })
  .slice(0, 2);
const canonicalUrl = new URL(route.path, settings.siteUrl).href;
const workSchema = isMethodology
  ? {
      "@type": "HowTo",
      "@id": `${canonicalUrl}#methodology`,
      name: record.title,
      description: record.summary,
      url: canonicalUrl,
      sameAs: record.publicUrl,
      author: {
        "@id": `${settings.siteUrl}#person`,
      },
      tool: record.technologies.map((name) => ({
        "@type": "HowToTool",
        name,
      })),
      step: practices.map((text, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: `Practice ${index + 1}`,
        text,
      })),
    }
  : {
      "@type": "CreativeWork",
      name: record.title,
      description: record.summary,
      url: record.publicUrl,
      creator: {
        "@id": `${settings.siteUrl}#person`,
      },
      keywords: record.technologies,
    };
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  activeRouteId="work"
  updatedDate={record.lastReviewed}
  ogType="article"
  structuredData={workSchema}
  breadcrumbs={[
    { label: "Overview", path: "" },
    { label: "Work", path: "work/" },
    { label: record.title },
  ]}
>
  <ContentStyles />
  <PageMasthead
    slot="masthead"
    eyebrow={record.type}
    title={record.title}
    lede={record.summary}
  >
    <div slot="metadata">
      <MetadataList items={recordMetadata} />
    </div>
    {
      project?.status !== "archived" && (
        <ActionLink href={record.publicUrl} newTab>
          {externalLinkLabel}
        </ActionLink>
      )
    }
    <ActionLink href="work/" variant="secondary">
      Back to work index
    </ActionLink>
  </PageMasthead>

  <section class="page-section" aria-labelledby="record-title">
    <Container>
      <div class="case-study-layout">
        <aside aria-labelledby="on-this-page-title">
          <h2 id="on-this-page-title">On this page</h2>
          <ol>
            <li>
              <a href="#record-title">
                {isMethodology ? "Method overview" : "Project overview"}
              </a>
            </li>
            {
              record.constraints.length > 0 && (
                <li>
                  <a href="#operating-constraints">Context</a>
                </li>
              )
            }
            <li>
              <a href="#technical-focus">
                {isMethodology ? "Delivery stack" : "Technology stack"}
              </a>
            </li>
            {
              (record.validation.length > 0 || record.outcome) && (
                <li>
                  <a href="#validation-outcome">Validation and outcome</a>
                </li>
              )
            }
            <li><a href="#public-scope">Public scope</a></li>
            {
              relatedProjects.length > 0 && (
                <li>
                  <a href="#related-work">Related work</a>
                </li>
              )
            }
          </ol>
        </aside>
        <article class="case-study">
          <section>
            <div class="case-study__status">
              <StatusBadge label={statusLabel} tone={statusTone} />
            </div>
            <h2 id="record-title">
              {isMethodology ? "Method overview" : "Project overview"}
            </h2>
            <p>{record.summary}</p>
            {
              ownership && (
                <p>
                  <strong>
                    {isMethodology ? "Method ownership:" : "Role:"}
                  </strong>{" "}
                  {ownership}
                </p>
              )
            }
          </section>

          {
            record.constraints.length > 0 && (
              <section>
                <h2 id="operating-constraints">Context and constraints</h2>
                <ul>
                  {record.constraints.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            )
          }

          <section>
            <h2 id="technical-focus">
              {isMethodology ? "Delivery stack" : "Technology stack"}
            </h2>
            <TechnologyList
              items={record.technologies}
              label={isMethodology ? "Delivery stack" : "Technology stack"}
            />
            {
              practices.length > 0 && (
                <>
                  <h3>
                    {isMethodology ? "Method in practice" : "Contributions"}
                  </h3>
                  <ul>
                    {practices.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </>
              )
            }
          </section>

          {
            (record.validation.length > 0 || record.outcome) && (
              <section>
                <h2 id="validation-outcome">Validation and outcome</h2>
                {record.validation.length > 0 && (
                  <ul>
                    {record.validation.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
                {record.outcome && (
                  <div class="case-study__outcome">
                    <strong>Outcome</strong>
                    <p>{record.outcome}</p>
                  </div>
                )}
              </section>
            )
          }

          <section class="integrity-note">
            <h2 id="public-scope">Public scope</h2>
            {
              isMethodology ? (
                <p>
                  The method, its delivery practices and the available
                  validation trail are documented in the public repository
                  linked above.
                </p>
              ) : project?.privacyStatus === "client-safe-summary" ? (
                <p>
                  Client confidentiality limits the implementation detail shared
                  here. This overview focuses on the system's purpose, Bongo's
                  role and the technologies used.
                </p>
              ) : project?.caseStudyDepth === "summary" ? (
                <p>
                  This focused overview is paired with the public repository,
                  where the code and project context can be reviewed directly.
                </p>
              ) : (
                <p>
                  The project source and available validation are linked above
                  for direct review.
                </p>
              )
            }
            {
              record.limitations.length > 0 && (
                <>
                  <h3>Constraints and limits</h3>
                  <ul>
                    {record.limitations.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </>
              )
            }
          </section>
        </article>
      </div>
    </Container>
  </section>

  {
    relatedProjects.length > 0 && (
      <section
        class="page-section page-section--surface"
        aria-labelledby="related-work"
      >
        <Container>
          <SectionIntro
            id="related-work"
            eyebrow="Continue exploring"
            title="Related work"
          />
          <div class="project-archive-grid">
            {relatedProjects.map((entry) => (
              <ProjectCard project={entry} variant="archive" />
            ))}
          </div>
        </Container>
      </section>
    )
  }
</BaseLayout>

<style>
  .case-study-layout {
    display: grid;
    grid-template-columns: minmax(12rem, 0.65fr) minmax(0, 2.35fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 6rem);
  }

  aside {
    padding: var(--space-5);
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  aside h2 {
    font-size: var(--step-0);
  }

  aside ol {
    display: grid;
    margin: var(--space-3) 0 0;
    padding-inline-start: 1.25rem;
    gap: var(--space-2);
  }

  aside a {
    display: inline-flex;
    min-block-size: var(--target-size);
    padding-block: 0.65rem;
    align-items: center;
    color: var(--rust-strong);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .case-study {
    max-inline-size: var(--case-study-measure);
  }

  .case-study > section + section {
    margin-block-start: var(--space-8);
  }

  .case-study h2 {
    font-size: var(--step-2);
  }

  .case-study h3 {
    margin-block: var(--space-5) var(--space-3);
    color: var(--indigo);
    font-size: var(--step-1);
  }

  .case-study p {
    margin-block-start: var(--space-4);
    color: var(--ink-soft);
    font-size: var(--step-0);
  }

  .case-study ul {
    display: grid;
    padding-inline-start: 1.2rem;
    gap: var(--space-2);
  }

  .case-study li::marker {
    color: var(--gold);
  }

  .case-study__status {
    margin-block-end: var(--space-4);
  }

  .case-study__outcome {
    margin-block-start: var(--space-5);
    padding: var(--space-5);
    border-inline-start: 0.25rem solid var(--gold);
    background: color-mix(in srgb, var(--gold) 8%, var(--surface));
  }

  .case-study__outcome strong {
    color: var(--rust-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .case-study__outcome p {
    margin-block-start: var(--space-2);
    color: var(--ink);
    font-weight: 650;
  }

  @media (max-width: 48rem) {
    .case-study-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
