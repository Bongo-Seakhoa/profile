---
import ContentStyles from "../../components/content/ContentStyles.astro";
import MethodologyCard from "../../components/content/MethodologyCard.astro";
import ProjectCard from "../../components/content/ProjectCard.astro";
import AnzaniaPlate from "../../components/media/AnzaniaPlate.astro";
import Container from "../../components/primitives/Container.astro";
import PageMasthead from "../../components/primitives/PageMasthead.astro";
import SectionIntro from "../../components/primitives/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadProfileContent } from "../../lib/content/load-content";

const content = await loadProfileContent();
const route = content.routes.find((entry) => entry.id === "work");
const settings = content.siteSettings[0];

if (!route || !settings) throw new Error("Work route content is missing.");

const sortedProjects = [...content.projects].sort((left, right) => {
  if (left.featured !== right.featured) return left.featured ? -1 : 1;
  return (
    (left.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
    (right.featuredOrder ?? Number.MAX_SAFE_INTEGER)
  );
});
const leadProject = sortedProjects[0];
const selectedProjects = sortedProjects.filter(
  (project) => project.featured && project.id !== leadProject?.id,
);
const archiveProjects = sortedProjects.filter((project) => !project.featured);
const methodologies = [...content.methodologies].sort((left, right) =>
  left.title.localeCompare(right.title, "en"),
);
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  activeRouteId={route.id}
  updatedDate={settings.lastReviewed}
>
  <ContentStyles />
  <PageMasthead
    slot="masthead"
    eyebrow="Selected engineering work"
    title={route.title}
    lede="Flagship AI systems, applied technical projects and a documented delivery methodology, with direct links to code and context."
  />

  <section
    class="page-section work-lead-section"
    aria-labelledby="lead-work-title"
    data-section-label="Flagship system"
  >
    <div class="work-lead-section__atmosphere" aria-hidden="true">
      <AnzaniaPlate
        id="archive-echoes-outer"
        use="work-evidence"
        decorative
        loading="eager"
        sizes="(min-width: 80rem) 72vw, 120vw"
      />
    </div>

    <Container>
      <SectionIntro
        id="lead-work-title"
        eyebrow="Flagship system"
        title="MetaPOS Mind: AI interaction grounded in governed context"
        description="MetaPOS Mind leads the portfolio because it brings together AI system design, data engineering and operational governance."
      />

      <div class="work-lead">
        {leadProject && <ProjectCard project={leadProject} variant="lead" />}

        <aside
          class="work-protocol"
          data-signal-card
          aria-labelledby="work-protocol-title"
        >
          <div class="work-protocol__header">
            <div>
              <p>Portfolio at a glance</p>
              <h2 id="work-protocol-title">What Bongo brings</h2>
            </div>
            <svg class="signal-glyph" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="32" cy="32" r="23"></circle>
              <path d="M32 9v46M9 32h46M16 16l32 32M48 16 16 48"></path>
              <circle class="signal-glyph__node" cx="32" cy="32" r="2.7"
              ></circle>
            </svg>
          </div>

          <dl>
            <div>
              <dt>Flagship</dt>
              <dd>MetaPOS Mind, a governed AI context system.</dd>
            </div>
            <div>
              <dt>Strengths</dt>
              <dd>AI systems, data engineering and analytics.</dd>
            </div>
            <div>
              <dt>Delivery</dt>
              <dd>Python, SQL, cloud platforms, MCP and applied models.</dd>
            </div>
            <div>
              <dt>Approach</dt>
              <dd>
                Human ownership, careful validation and clear communication.
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </Container>
  </section>

  <section
    class="page-section page-section--surface"
    aria-labelledby="selected-work-title"
    data-section-label="Selected records"
  >
    <Container>
      <SectionIntro
        id="selected-work-title"
        eyebrow="Selected records"
        title="Applied AI and data work"
        description="Public repositories show the code behind selected projects; professional work is summarized with client confidentiality intact."
      />
      <div class="project-archive-grid work-record-grid">
        {
          selectedProjects.map((project) => (
            <ProjectCard project={project} variant="standard" />
          ))
        }
      </div>
    </Container>
  </section>

  {
    methodologies.length > 0 && (
      <section
        class="page-section"
        aria-labelledby="methodology-title"
        data-section-label="Delivery methodology"
      >
        <Container>
          <SectionIntro
            id="methodology-title"
            eyebrow="Delivery methodology"
            title="How human ownership stays central in AI-assisted delivery"
            description="A transparent method for combining human direction with AI implementation, independent verification, durable handoffs and repeatable quality gates."
          />
          <div class="project-archive-grid work-record-grid">
            {methodologies.map((methodology) => (
              <MethodologyCard methodology={methodology} variant="standard" />
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <section
    class="page-section page-section--surface"
    aria-labelledby="archive-title"
    data-section-label="Project archive"
  >
    <Container>
      <SectionIntro
        id="archive-title"
        eyebrow="Project archive"
        title="Additional systems and experiments"
        description="Earlier work across recommendation, APIs, environmental data and algorithmic trading shows technical range."
      />
      <div
        class="project-archive-grid work-record-grid work-record-grid--archive"
      >
        {
          archiveProjects.map((project) => (
            <ProjectCard project={project} variant="archive" />
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .work-lead-section {
    isolation: isolate;
    overflow: hidden;
  }

  .work-lead-section::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      98deg,
      var(--canvas) 0 42%,
      rgb(243 234 217 / 82%) 67%,
      var(--canvas)
    );
    content: "";
  }

  .work-lead-section__atmosphere {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline-end: -8vw;
    inline-size: min(78rem, 72vw);
    opacity: 0.2;
    filter: saturate(0.5) sepia(0.13) contrast(0.96);
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 30%,
      black 82%,
      transparent
    );
    pointer-events: none;
  }

  .work-lead-section__atmosphere :global(.anzania-plate),
  .work-lead-section__atmosphere :global(img) {
    inline-size: 100%;
    block-size: 100%;
  }

  .work-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(19rem, 0.7fr);
    align-items: stretch;
    gap: var(--space-5);
  }

  .work-protocol {
    display: flex;
    min-inline-size: 0;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    flex-direction: column;
    border: 1px solid var(--line-strong);
    background: rgb(251 245 234 / 84%);
    box-shadow: 0 1.2rem 3rem rgb(48 32 20 / 8%);
    backdrop-filter: blur(0.65rem);
  }

  .work-protocol__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.4rem;
    padding-block-end: var(--space-5);
    border-block-end: 1px solid var(--line);
  }

  .work-protocol__header p {
    color: var(--rust-strong);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .work-protocol__header h2 {
    max-inline-size: 17ch;
    margin-block-start: 0.3rem;
    font-size: var(--step-2);
  }

  .work-protocol dl {
    display: grid;
    margin: 0;
  }

  .work-protocol dl > div {
    display: grid;
    padding-block: var(--space-4);
    grid-template-columns: 5.4rem minmax(0, 1fr);
    gap: var(--space-3);
    border-block-end: 1px solid var(--line);
  }

  .work-protocol dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .work-protocol dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.46;
  }

  .work-record-grid {
    align-items: stretch;
  }

  .work-record-grid--archive {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 66rem) {
    .work-lead {
      grid-template-columns: 1fr;
    }

    .work-protocol {
      max-inline-size: 46rem;
    }

    .work-lead-section__atmosphere {
      inset-inline-end: -26vw;
      inline-size: 112vw;
      opacity: 0.15;
    }

    .work-record-grid--archive {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .work-protocol dl > div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .work-record-grid--archive {
      grid-template-columns: 1fr;
    }
  }
</style>
