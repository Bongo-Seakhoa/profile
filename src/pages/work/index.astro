---
import ContentStyles from "../../components/content/ContentStyles.astro";
import ProjectCard from "../../components/content/ProjectCard.astro";
import AnzaniaPlate from "../../components/media/AnzaniaPlate.astro";
import Container from "../../components/primitives/Container.astro";
import PageMasthead from "../../components/primitives/PageMasthead.astro";
import SectionIntro from "../../components/primitives/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadProfileContent } from "../../lib/content/load-content";

const content = await loadProfileContent();
const route = content.routes.find((entry) => entry.id === "work");
const settings = content.siteSettings[0];

if (!route || !settings) throw new Error("Work route content is missing.");

const sortedProjects = [...content.projects].sort((left, right) => {
  if (left.featured !== right.featured) return left.featured ? -1 : 1;
  return (
    (left.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
    (right.featuredOrder ?? Number.MAX_SAFE_INTEGER)
  );
});
const leadProject =
  sortedProjects.find(
    (project) => project.id === "fxpm-1-4-forex-portfolio-manager",
  ) ?? sortedProjects[0];
const selectedProjects = sortedProjects.filter(
  (project) => project.featured && project.id !== leadProject?.id,
);
const archiveProjects = sortedProjects.filter((project) => !project.featured);
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  activeRouteId={route.id}
  updatedDate={settings.lastReviewed}
>
  <ContentStyles />
  <PageMasthead
    slot="masthead"
    eyebrow="Evidence-led portfolio"
    title={route.title}
    lede="Professional contributions, public repositories and technical experiments. Each record states its evidence and privacy boundary."
  />

  <section class="page-section" aria-labelledby="lead-work-title">
    <Container>
      <SectionIntro
        id="lead-work-title"
        eyebrow="Lead system"
        title="A closer look at applied technical work"
      />
      <div class="work-lead">
        {leadProject && <ProjectCard project={leadProject} variant="lead" />}
        <figure>
          <AnzaniaPlate
            id="archive-echoes-outer"
            use="work-evidence"
            decorative
            loading="eager"
            sizes="(min-width: 60rem) 45vw, 100vw"
          />
          <figcaption>
            Archive of Echoes artwork. It provides visual context only; project
            evidence remains linked in the project record.
          </figcaption>
        </figure>
      </div>
    </Container>
  </section>

  <section
    class="page-section page-section--surface"
    aria-labelledby="selected-work-title"
  >
    <Container>
      <SectionIntro
        id="selected-work-title"
        eyebrow="Selected records"
        title="Professional and public project work"
        description="Client-sensitive contributions are intentionally concise. Public repositories link directly to their source evidence."
      />
      <div class="project-archive-grid">
        {
          selectedProjects.map((project) => (
            <ProjectCard project={project} variant="standard" />
          ))
        }
      </div>
    </Container>
  </section>

  <section class="page-section" aria-labelledby="archive-title">
    <Container>
      <SectionIntro
        id="archive-title"
        eyebrow="Project archive"
        title="Additional systems and experiments"
        description="These records are useful evidence of range. Their labels distinguish public work, experiments and archived material."
      />
      <div class="project-archive-grid">
        {
          archiveProjects.map((project) => (
            <ProjectCard project={project} variant="archive" />
          ))
        }
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .work-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: stretch;
    gap: var(--space-5);
  }

  figure {
    display: flex;
    margin: 0;
    flex-direction: column;
  }

  figure :global(.anzania-plate) {
    min-block-size: 28rem;
    flex: 1;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-medium);
  }

  figcaption {
    margin-block-start: var(--space-2);
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  @media (max-width: 58rem) {
    .work-lead {
      grid-template-columns: 1fr;
    }

    figure :global(.anzania-plate) {
      min-block-size: 0;
      aspect-ratio: 16 / 9;
    }
  }
</style>
