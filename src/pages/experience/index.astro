---
import ContentStyles from "../../components/content/ContentStyles.astro";
import ExperienceRecord from "../../components/content/ExperienceRecord.astro";
import ActionLink from "../../components/primitives/ActionLink.astro";
import Container from "../../components/primitives/Container.astro";
import PageMasthead from "../../components/primitives/PageMasthead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadProfileContent } from "../../lib/content/load-content";

const content = await loadProfileContent();
const route = content.routes.find((entry) => entry.id === "experience");

if (!route) throw new Error("Experience route content is missing.");

const experience = [...content.experience].sort((left, right) =>
  right.dateStart.localeCompare(left.dateStart),
);
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  activeRouteId={route.id}
>
  <ContentStyles />
  <PageMasthead
    slot="masthead"
    eyebrow="Professional timeline"
    title={route.title}
    lede="Data delivery, analytics, learning support and mentoring across remote teams in Africa, Australia and Europe."
  >
    <ActionLink href="documents/">Resume and CV</ActionLink>
    <ActionLink href="contact/" variant="secondary">Contact</ActionLink>
  </PageMasthead>

  <section
    class="page-section page-section--compact"
    aria-labelledby="timeline-note-title"
  >
    <Container size="content">
      <div class="route-intro-note">
        <h2 id="timeline-note-title">Concurrent remote roles</h2>
        <p>
          Several roles overlapped across time zones and organisations. Dates
          are shown month by month so progression and concurrency are easy to
          follow.
        </p>
      </div>
    </Container>
  </section>

  <section
    class="page-section page-section--surface"
    aria-label="Professional experience"
  >
    <Container size="content">
      <div class="record-stack">
        {experience.map((record) => <ExperienceRecord experience={record} />)}
      </div>
    </Container>
  </section>
</BaseLayout>
