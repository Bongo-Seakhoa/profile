---
import CapabilityRecord from "../components/content/CapabilityRecord.astro";
import ContentStyles from "../components/content/ContentStyles.astro";
import ExperienceRecord from "../components/content/ExperienceRecord.astro";
import ProjectCard from "../components/content/ProjectCard.astro";
import AnzaniaPlate from "../components/media/AnzaniaPlate.astro";
import ActionLink from "../components/primitives/ActionLink.astro";
import Container from "../components/primitives/Container.astro";
import SectionIntro from "../components/primitives/SectionIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadProfileContent } from "../lib/content/load-content";
import { sitePath } from "../lib/urls";

const content = await loadProfileContent();
const identity = content.identity[0];
const route = content.routes.find((entry) => entry.id === "home");

if (!identity || !route) {
  throw new Error("Homepage identity or route content is missing.");
}

const featuredProjects = content.projects
  .filter((project) => project.featured)
  .sort(
    (left, right) =>
      (left.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
      (right.featuredOrder ?? Number.MAX_SAFE_INTEGER),
  );
const leadProject =
  featuredProjects.find(
    (project) => project.id === "fxpm-1-4-forex-portfolio-manager",
  ) ?? featuredProjects[0];
const supportingProjects = featuredProjects.filter(
  (project) => project.id !== leadProject?.id,
);
const featuredExperience = content.experience
  .filter((experience) => experience.featured)
  .sort(
    (left, right) =>
      (left.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
      (right.featuredOrder ?? Number.MAX_SAFE_INTEGER),
  );
const activeCloudCredentials = content.credentials.filter(
  (credential) =>
    credential.category === "current-cloud" && credential.status === "active",
);
const linkedin = identity.links.find((link) => link.id === "linkedin");
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  activeRouteId={route.id}
  updatedDate={identity.lastReviewed}
>
  <ContentStyles />

  <section
    class="home-hero"
    aria-labelledby="home-title"
    data-section-label="Profile signal"
  >
    <Container>
      <div class="home-hero__frame">
        <div class="home-hero__coordinate-line" aria-hidden="true">
          <span>FIELD 00</span>
          <span>PROFESSIONAL RECORD</span>
          <span>ACTIVE SIGNAL</span>
        </div>

        <div class="home-hero__grid">
          <div class="home-hero__copy">
            <p class="home-hero__eyebrow">{identity.headline}</p>
            <h1 id="home-title">{identity.primaryName}</h1>
            <p class="home-hero__statement">{identity.valueStatement}</p>

            <div class="home-hero__actions">
              <ActionLink href="work/">View selected work</ActionLink>
              <ActionLink href="documents/" variant="secondary">
                Resume and CV
              </ActionLink>
              <ActionLink href="contact/" variant="secondary"
                >Contact</ActionLink
              >
            </div>

            <p class="home-hero__experience-note">
              Prefer the cinematic route? <a href={sitePath("explore/")}
                >Explore Anzania</a
              >, an optional journey through the same professional record.
              Anzania is fictional.
            </p>

            <dl class="home-hero__meta">
              <div>
                <dt>Current focus</dt>
                <dd>Data engineering and analytics at MetaPOS</dd>
              </div>
              <div>
                <dt>Based in</dt>
                <dd>{identity.location}</dd>
              </div>
            </dl>
          </div>

          <aside
            class="home-hero__ledger"
            data-signal-card
            aria-labelledby="system-profile-title"
          >
            <div class="home-hero__ledger-heading">
              <strong>System profile / live index</strong>
              <span>BS.2026.08</span>
            </div>

            <svg
              class="home-hero__signal-graph"
              viewBox="0 0 520 252"
              role="img"
              aria-label="A signal path connecting data, models, systems and decisions"
            >
              <path
                class="home-hero__signal-grid"
                d="M30 198h460M30 126h460M30 54h460"></path>
              <path
                class="home-hero__signal-path"
                d="M30 198C110 198 98 68 190 68s76 104 154 104 78-116 146-116"
              ></path>
              <circle cx="30" cy="198" r="7"></circle>
              <circle cx="190" cy="68" r="7"></circle>
              <circle cx="344" cy="172" r="7"></circle>
              <circle cx="490" cy="56" r="7"></circle>
              <text x="30" y="226">DATA</text>
              <text x="168" y="42">MODELS</text>
              <text x="317" y="203">SYSTEMS</text>
              <text x="424" y="31">DECISIONS</text>
              <text class="home-hero__graph-copy" x="30" y="243">
                SIGNAL / INTERPRETATION / DELIVERY / ACTION
              </text>
            </svg>

            <div class="home-hero__ledger-copy">
              <h2 id="system-profile-title">
                From raw signal to usable systems.
              </h2>
              <p>
                Cloud data engineering, applied machine learning and decision
                support, communicated for the people who need to act.
              </p>
            </div>

            <dl class="home-hero__console-grid">
              <div>
                <dt>{String(content.projects.length).padStart(2, "0")}</dt>
                <dd>Documented project records</dd>
              </div>
              <div>
                <dt>{String(content.experience.length).padStart(2, "0")}</dt>
                <dd>Professional experience records</dd>
              </div>
              <div>
                <dt>
                  {String(activeCloudCredentials.length).padStart(2, "0")}
                </dt>
                <dd>Active cloud credentials</dd>
              </div>
            </dl>
          </aside>
        </div>

        <div class="home-hero__rune" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
      </div>
    </Container>
  </section>

  <section
    class="proof-section"
    aria-label="Professional overview"
    data-section-label="Evidence overview"
  >
    <Container>
      <div class="evidence-band">
        <div class="evidence-band__item">
          <span class="evidence-band__index">01 / CURRENT</span>
          <p>Current data engineering work at MetaPOS</p>
        </div>
        <div class="evidence-band__item">
          <span class="evidence-band__index">02 / RANGE</span>
          <p>Data engineering, analytics and applied machine learning</p>
        </div>
        <div class="evidence-band__item">
          <span class="evidence-band__index">03 / STUDY</span>
          <p>Engineering Management study at the University of Debrecen</p>
        </div>
        <div class="evidence-band__item">
          <span class="evidence-band__index">04 / VERIFIED</span>
          <p>
            {activeCloudCredentials.length} current Google Cloud credentials, active
            through 2027
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section
    class="page-section home-work-signal"
    aria-labelledby="featured-work-title"
    data-section-label="Selected work"
  >
    <div class="home-work-signal__atmosphere" aria-hidden="true">
      <AnzaniaPlate
        id="archive-echoes-outer"
        use="work-evidence"
        decorative
        loading="lazy"
        sizes="(min-width: 80rem) 72vw, 120vw"
      />
    </div>
    <Container>
      <SectionIntro
        id="featured-work-title"
        eyebrow="Selected work"
        title="Systems, analysis and applied models"
        description="Public evidence and client-safe summaries, with scope and status stated clearly."
      />
      <div class="featured-work-grid">
        {leadProject && <ProjectCard project={leadProject} variant="lead" />}
        <div class="featured-work-grid__supporting">
          {
            supportingProjects.map((project) => (
              <ProjectCard project={project} variant="standard" />
            ))
          }
        </div>
      </div>
      <div class="section-actions">
        <ActionLink href="work/" variant="secondary">
          Browse the complete work index
        </ActionLink>
      </div>
    </Container>
  </section>

  <section
    class="page-section page-section--surface"
    aria-labelledby="capabilities-title"
    data-section-label="Capabilities"
  >
    <Container>
      <SectionIntro
        id="capabilities-title"
        eyebrow="Capabilities"
        title="Practical technical work, communicated clearly"
        description="Each capability starts with the problem, then connects delivery to public or client-safe evidence."
      />
      <div class="home-capabilities">
        {
          content.capabilities.map((capability, index) => (
            <CapabilityRecord capability={capability} index={index + 1} />
          ))
        }
      </div>
      <div class="section-actions">
        <ActionLink href="capabilities/" variant="quiet">
          Read the capability detail
        </ActionLink>
      </div>
    </Container>
  </section>

  <section
    class="page-section"
    aria-labelledby="experience-title"
    data-section-label="Experience"
  >
    <Container>
      <SectionIntro
        id="experience-title"
        eyebrow="Experience"
        title="Delivery across data and learning"
        description="Reverse-chronological records show overlapping remote work directly, without inferring employment type."
      />
      <div class="record-stack">
        {
          featuredExperience.map((experience) => (
            <ExperienceRecord experience={experience} compact />
          ))
        }
      </div>
      <div class="section-actions">
        <ActionLink href="experience/" variant="secondary">
          View full experience
        </ActionLink>
      </div>
    </Container>
  </section>

  <section
    class="page-section page-section--muted"
    aria-labelledby="research-education-title"
    data-section-label="Learning and inquiry"
  >
    <Container>
      <SectionIntro
        id="research-education-title"
        eyebrow="Learning and inquiry"
        title="Research experiments and formal study"
      />
      <div class="home-split-panels">
        <article data-signal-card>
          <p class="home-split-panels__label">Research and experiments</p>
          <h3>Public technical explorations</h3>
          <p>
            CNN filter visualisation, environmental data analysis and trading
            experiments are labelled by evidence state. They are not presented
            as publications.
          </p>
          <a href={sitePath("research/")}>Review research and experiments</a>
        </article>
        <article data-signal-card>
          <p class="home-split-panels__label">Education and credentials</p>
          <h3>Current study and verified learning</h3>
          <p>
            Formal study at the University of Debrecen, Explore AI Academy
            training and active Google Cloud credentials are recorded with dates
            and verification links.
          </p>
          <div>
            <a href={sitePath("education/")}>View education</a>
            <a href={sitePath("credentials/")}>Verify credentials</a>
          </div>
        </article>
      </div>
    </Container>
  </section>

  <section
    class="page-section page-section--compact"
    aria-labelledby="about-preview-title"
    data-section-label="Working approach"
  >
    <Container size="content">
      <div class="about-preview">
        <p class="about-preview__label">About</p>
        <div>
          <h2 id="about-preview-title">
            Reliable data work depends on technical care and useful
            communication.
          </h2>
          <p>{identity.summary[0]}</p>
          <a href={sitePath("about/")}>More about my work and background</a>
        </div>
      </div>
    </Container>
  </section>

  <section
    class="page-section home-contact-section"
    aria-labelledby="contact-close-title"
    data-section-label="Contact"
  >
    <Container>
      <div class="contact-panel home-contact-panel">
        <div class="home-contact-panel__atmosphere" aria-hidden="true">
          <AnzaniaPlate
            id="oasis-audience-inner"
            use="contact-call-to-action"
            decorative
            loading="lazy"
            sizes="(min-width: 60rem) 58vw, 120vw"
          />
        </div>
        <div class="home-contact-panel__copy">
          <p class="contact-panel__eyebrow">Start a conversation</p>
          <h2 id="contact-close-title">Bring a data problem into focus.</h2>
          <p>{identity.availability}</p>
        </div>
        <div class="contact-panel__links">
          <a href={`mailto:${identity.email}`}>Email Bongo</a>
          {linkedin && <a href={linkedin.url}>LinkedIn profile</a>}
          <a href={sitePath("documents/")}>Resume and CV</a>
          <a href={sitePath("contact/")}>Contact details</a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-block-size: min(52rem, calc(100svh - var(--header-offset)));
    align-items: center;
    overflow: hidden;
    padding-block: clamp(2rem, 4vw, 4rem);
    border-block-end: 1px solid var(--line-strong);
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgb(247 239 223 / 98%) 0%,
        rgb(247 239 223 / 91%) 44%,
        rgb(247 239 223 / 48%) 76%,
        rgb(247 239 223 / 68%) 100%
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 7.9rem,
        rgb(43 33 25 / 4%) 7.9rem 8rem
      );
    content: "";
    pointer-events: none;
  }

  .home-hero__frame {
    position: relative;
    z-index: 1;
    padding-block: 0;
  }

  .home-hero__coordinate-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.4rem;
    margin-block-end: clamp(1.5rem, 3vw, 3rem);
    color: rgb(72 48 31 / 58%);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .home-hero__coordinate-line span + span::before {
    margin-inline-end: 1.4rem;
    color: var(--gold-ink);
    content: "◇";
  }

  .home-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(21rem, 0.75fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 7rem);
  }

  .home-hero__copy {
    min-inline-size: 0;
  }

  .home-hero__eyebrow,
  .about-preview__label,
  .home-split-panels__label,
  .contact-panel__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--rust-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-inline-size: 8ch;
    font-size: clamp(4.2rem, 10vw, 9.2rem);
    letter-spacing: -0.065em;
    line-height: 0.82;
  }

  .home-hero__statement {
    max-inline-size: 44ch;
    margin-block-start: var(--space-6);
    color: var(--ink-soft);
    font-family: var(--font-display);
    font-size: clamp(1.28rem, 2vw, 1.85rem);
    line-height: 1.42;
  }

  .home-hero__actions {
    display: flex;
    margin-block-start: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-hero__experience-note {
    max-inline-size: 62ch;
    margin: var(--space-4) 0 0;
    color: var(--ink-soft);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .home-hero__experience-note a {
    color: var(--rust-strong);
    font-weight: 750;
  }

  .home-hero__meta {
    display: grid;
    max-inline-size: 43rem;
    margin: var(--space-6) 0 0;
    padding-block-start: var(--space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    border-block-start: 1px solid var(--line-strong);
  }

  .home-hero__meta dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-hero__meta dd {
    margin: var(--space-2) 0 0;
    font-size: 0.82rem;
    font-weight: 750;
  }

  .home-hero__ledger {
    position: relative;
    overflow: hidden;
    padding: clamp(1.55rem, 3vw, 2.45rem);
    border: 1px solid rgb(237 201 120 / 32%);
    background:
      linear-gradient(145deg, rgb(29 24 19 / 97%), rgb(24 20 16 / 94%)),
      var(--route-scene);
    background-position:
      center,
      74% 40%;
    background-size: cover;
    box-shadow: 0 1.8rem 5rem rgb(26 17 10 / 24%);
    color: var(--surface);
    backdrop-filter: blur(0.8rem);
    clip-path: polygon(
      0 0,
      calc(100% - 1.25rem) 0,
      100% 1.25rem,
      100% 100%,
      1.25rem 100%,
      0 calc(100% - 1.25rem)
    );
  }

  .home-hero__ledger::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 82% 18%,
        rgb(211 166 81 / 13%),
        transparent 34%
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 4.9rem,
        rgb(255 249 238 / 2.7%) 4.9rem 5rem
      );
    content: "";
    pointer-events: none;
  }

  .home-hero__ledger-heading {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block-end: var(--space-4);
    border-block-end: 1px solid rgb(255 249 238 / 15%);
    color: var(--gold-light);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .home-hero__ledger-heading span {
    color: rgb(255 249 238 / 48%);
    font-size: 0.55rem;
  }

  .home-hero__signal-graph {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    margin-block-start: var(--space-5);
    overflow: visible;
  }

  .home-hero__signal-grid,
  .home-hero__signal-path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .home-hero__signal-grid {
    stroke: rgb(255 249 238 / 8%);
  }

  .home-hero__signal-path {
    stroke: #6e9b91;
    stroke-width: 2;
  }

  .home-hero__signal-graph circle {
    fill: var(--gold-light);
  }

  .home-hero__signal-graph text {
    fill: var(--gold-light);
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .home-hero__signal-graph .home-hero__graph-copy {
    fill: rgb(255 249 238 / 38%);
    font-size: 6px;
    letter-spacing: 0.06em;
  }

  .home-hero__ledger-copy {
    position: relative;
    z-index: 1;
    margin-block-start: var(--space-3);
  }

  .home-hero__ledger-copy h2 {
    max-inline-size: 18ch;
    color: var(--surface);
    font-size: clamp(1.75rem, 2.5vw, 2.6rem);
  }

  .home-hero__ledger-copy p {
    max-inline-size: 48ch;
    margin-block-start: var(--space-3);
    color: rgb(255 249 238 / 68%);
    font-size: 0.82rem;
  }

  .home-hero__console-grid {
    position: relative;
    z-index: 1;
    display: grid;
    margin: var(--space-5) 0 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: rgb(8 7 6 / 34%);
  }

  .home-hero__console-grid > div {
    padding: var(--space-4);
    border-inline-start: 1px solid rgb(255 249 238 / 14%);
  }

  .home-hero__console-grid > div:first-child {
    border-inline-start: 0;
  }

  .home-hero__console-grid dt {
    color: var(--gold-light);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .home-hero__console-grid dd {
    margin: var(--space-2) 0 0;
    color: rgb(255 249 238 / 58%);
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .home-hero__rune {
    position: absolute;
    inset-inline-end: -2rem;
    inset-block-end: -3rem;
    display: grid;
    inline-size: clamp(9rem, 17vw, 16rem);
    aspect-ratio: 1;
    place-items: center;
    opacity: 0.24;
    pointer-events: none;
  }

  .home-hero__rune span {
    position: absolute;
    border: 1px solid var(--rust);
    transform: rotate(45deg);
  }

  .home-hero__rune span:nth-child(1) {
    inline-size: 100%;
    block-size: 100%;
  }

  .home-hero__rune span:nth-child(2) {
    inline-size: 68%;
    block-size: 68%;
  }

  .home-hero__rune span:nth-child(3) {
    inline-size: 28%;
    block-size: 28%;
    background: rgb(211 166 81 / 18%);
  }

  .proof-section {
    position: relative;
    z-index: 2;
    margin-block-start: -1px;
    background: rgb(243 234 217 / 82%);
  }

  .home-work-signal {
    isolation: isolate;
    overflow: hidden;
  }

  .home-work-signal::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      100deg,
      var(--canvas) 0 38%,
      rgb(243 234 217 / 82%) 67%,
      var(--canvas) 100%
    );
    content: "";
  }

  .home-work-signal__atmosphere {
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline-end: -8vw;
    inline-size: min(68rem, 68vw);
    opacity: 0.2;
    filter: saturate(0.55) sepia(0.12);
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 34%,
      black 78%,
      transparent
    );
    pointer-events: none;
  }

  .home-work-signal__atmosphere :global(.anzania-plate),
  .home-work-signal__atmosphere :global(img) {
    inline-size: 100%;
    block-size: 100%;
  }

  .featured-work-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(20rem, 0.72fr);
    gap: var(--space-5);
  }

  .featured-work-grid__supporting {
    display: grid;
    gap: var(--space-5);
  }

  .home-capabilities :global(.capability-record) {
    padding-block: var(--space-6);
  }

  .home-split-panels {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-5);
  }

  .home-split-panels article {
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line-strong);
    background: rgb(251 245 234 / 80%);
    backdrop-filter: blur(0.5rem);
  }

  .home-split-panels h3 {
    max-inline-size: 22ch;
    font-size: var(--step-2);
  }

  .home-split-panels article > p:not(.home-split-panels__label) {
    max-inline-size: 56ch;
    margin-block-start: var(--space-4);
    color: var(--ink-soft);
  }

  .home-split-panels article > a,
  .home-split-panels article > div {
    margin-block-start: var(--space-5);
  }

  .home-split-panels a {
    display: inline-flex;
    min-block-size: var(--target-size);
    margin-inline-end: var(--space-4);
    padding-block: 0.65rem;
    align-items: center;
    color: var(--rust-strong);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .about-preview {
    display: grid;
    grid-template-columns: minmax(8rem, 0.4fr) minmax(0, 1.6fr);
    gap: clamp(1.5rem, 5vw, 4rem);
  }

