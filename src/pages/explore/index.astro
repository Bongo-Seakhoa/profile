---
import "@fontsource-variable/source-serif-4/wght.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource/ibm-plex-mono/400.css";

import { absoluteUrl, sitePath } from "../../lib/urls";

const title = "Explore Anzania | Bongo Seakhoa";
const description =
  "Explore Anzania, Bongo Seakhoa's cinematic 2.5D portfolio journey through AI systems, data work, research, capability and purpose.";
const canonicalUrl = absoluteUrl(
  "explore/",
  "https://bongo-seakhoa.github.io/profile/",
);
const socialImageUrl = absoluteUrl(
  "assets/social/explore.jpg",
  "https://bongo-seakhoa.github.io/profile/",
);
const sitemapUrl = absoluteUrl(
  "sitemap-index.xml",
  "https://bongo-seakhoa.github.io/profile/",
);
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: "Explore Anzania",
  alternateName: "Anzania Portfolio Journey",
  description,
  creator: {
    "@type": "Person",
    name: "Bongo Seakhoa",
    alternateName: "Bongo Kosa",
  },
  genre: ["Interactive portfolio", "Narrative experience", "2.5D experience"],
  isPartOf: {
    "@type": "WebSite",
    name: "Bongo Seakhoa - Portfolio",
    url: "https://bongo-seakhoa.github.io/profile/",
  },
  url: canonicalUrl,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" data-view="explore" data-experience-state="loading">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#15120e" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Bongo Seakhoa, Bongo Kosa, interactive portfolio, Anzania, data engineering, analytics, applied machine learning"
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <link
      rel="icon"
      href={sitePath("favicon-32.png")}
      sizes="32x32"
      type="image/png"
    />
    <link rel="manifest" href={sitePath("site.webmanifest")} />
    <link rel="sitemap" href={sitemapUrl} type="application/xml" />
    <link
      rel="preload"
      as="image"
      href={sitePath("assets/immersive/scenes/threshold-dunes-outer-1600.webp")}
      fetchpriority="high"
    />
    <link
      rel="stylesheet"
      href={sitePath("assets/immersive/anzania-explorer.css")}
    />
    <link
      rel="stylesheet"
      href={sitePath("assets/immersive/anzania-explorer-v2.css")}
    />

    <meta property="og:site_name" content="Bongo Seakhoa - Portfolio" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Explore Anzania, a cinematic 2.5D portfolio journey by Bongo Seakhoa."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" is:inline set:html={structuredData} />
  </head>
  <body>
    <a class="explore-skip-link" href="#chapter-content">Skip to chapter</a>

    <div
      class="experience"
      id="experience"
      data-experience
      data-scene-mode="outer"
      data-biome="sand"
      data-active-power="sand-teleportation"
    >
      <div class="scene" aria-hidden="true">
        <div class="scene__image scene__image--previous" data-scene-previous>
        </div>
        <div class="scene__image scene__image--current" data-scene-current>
        </div>
        <div
          class="scene__foreground scene__foreground--previous"
          data-scene-foreground-previous
        >
        </div>
        <div
          class="scene__foreground scene__foreground--current"
          data-scene-foreground
        >
        </div>
        <div class="scene__veil"></div>
        <div class="scene__vignette"></div>
        <div class="scene__grain"></div>
        <div class="scene__horizon-line"></div>
        <div class="scene__sky" aria-hidden="true">
          <span class="scene__cloud scene__cloud--one"></span>
          <span class="scene__cloud scene__cloud--two"></span>
          <span class="scene__cloud scene__cloud--three"></span>
        </div>
        <div class="scene__light-rays" aria-hidden="true"></div>
        <div class="scene__weather" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="scene__environment" data-environment-fx>
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="scene__cursor-field"></div>
      </div>

      <div class="power-transition" data-power-transition aria-hidden="true">
        <span class="power-transition__sun"></span>
        <span class="power-transition__sand"></span>
        <span class="power-transition__wake"></span>
        <span class="power-transition__ring"></span>
        <span class="power-transition__portal"></span>
        <span class="power-transition__streaks"></span>
        <span class="power-transition__contact"></span>
        <span class="power-transition__name" data-power-transition-name
          >Sandfold</span
        >
        <span class="power-transition__caption" data-power-transition-caption
          >Dissolve into a vortex, then reform beyond the horizon.</span
        >
      </div>

      <div
        class="loading-gate"
        data-loading-gate
        role="status"
        aria-live="polite"
      >
        <div class="loading-gate__sigil" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <p class="loading-gate__eyebrow">Preparing the crossing</p>
        <p class="loading-gate__title">ANZANIA</p>
        <p class="loading-gate__world-note">A cinematic portfolio journey</p>
        <div class="loading-gate__track" aria-hidden="true">
          <span data-loading-progress></span>
        </div>
        <p class="loading-gate__status" data-loading-status>
          Reading the atlas...
        </p>
      </div>

      <section
        class="arrival-gate"
        data-arrival-gate
        aria-labelledby="arrival-title"
        hidden
      >
        <div class="arrival-gate__frame">
          <p class="arrival-gate__kicker">A portfolio told as a journey</p>
          <h1 id="arrival-title">ANZANIA</h1>
          <p class="arrival-gate__definition">Anzania is a fictional place.</p>
          <p class="arrival-gate__invitation">
            Cross eight locations. Choose an original illustrated companion and
            decide how you travel. Every place opens into a deeper, living
            record of the work.
          </p>
          <div class="arrival-gate__actions">
            <button
              class="explore-button explore-button--primary"
              data-begin-journey
              type="button"
            >
              Begin the journey
              <span aria-hidden="true">→</span>
            </button>
            <a class="explore-button explore-button--quiet" href={sitePath("")}>
              Continue in Static View
            </a>
          </div>
          <p class="arrival-gate__note">
            Keyboard: left and right travel · Enter opens a location · hold V to
            view the scene · hold L to look back
          </p>
        </div>
      </section>

      <div class="explorer-shell" data-explorer hidden>
        <header class="explorer-topbar">
          <a
            class="explorer-brand"
            href={sitePath("")}
            aria-label="Return to Bongo Seakhoa's Static View portfolio"
          >
            <span class="explorer-brand__name">BONGO SEAKHOA</span>
            <span class="explorer-brand__world">Explore Anzania</span>
          </a>

          <div class="journey-progress" aria-label="Journey progress">
            <span class="journey-progress__label" data-progress-label
              >01 / 08</span
            >
            <span class="journey-progress__track" aria-hidden="true">
              <span data-progress-bar></span>
            </span>
          </div>

          <nav class="explorer-tools" aria-label="Explore controls">
            <button
              class="tool-button"
              data-map-button
              type="button"
              aria-haspopup="dialog"
              aria-label="Atlas"
            >
              <span aria-hidden="true">◇</span>
              <span>Atlas</span>
            </button>
            <button
              class="tool-button"
              data-guide-button
              type="button"
              aria-haspopup="dialog"
              aria-label="Guide"
            >
              <span aria-hidden="true">◉</span>
              <span>Guide</span>
            </button>
            <button
              class="tool-button tool-button--scene"
              data-view-scene-button
              type="button"
              aria-label="Press and hold to view the current scene"
              aria-keyshortcuts="V"
              aria-pressed="false"
            >
              <span aria-hidden="true">◫</span>
              <span data-view-scene-label>View scene</span>
            </button>
            <button
              class="tool-button"
              data-options-button
              type="button"
              aria-haspopup="dialog"
              aria-label="Options"
            >
              <span aria-hidden="true">＋</span>
              <span>Options</span>
            </button>
          </nav>
        </header>

        <aside class="location-rail" aria-label="Anzania locations">
          <p class="location-rail__title">THE CROSSING</p>
          <ol data-location-rail-list></ol>
        </aside>

        <section class="location-mark" aria-labelledby="location-name">
          <p class="location-mark__number" data-location-number>01</p>
          <div>
            <p class="location-mark__region" data-location-region>
              The Western Reach
            </p>
            <h2 id="location-name" data-location-name>Threshold Dunes</h2>
          </div>
        </section>

        <main
          class="chapter-panel"
          id="chapter-content"
          data-chapter-panel
          data-mode="outer"
          tabindex="-1"
        >
          <div class="chapter-panel__rule" aria-hidden="true"></div>
          <div class="chapter-panel__meta">
            <p class="chapter-panel__eyebrow" data-chapter-eyebrow>
              The point of entry
            </p>
            <p class="chapter-panel__signal">
              <span data-chapter-signal>Now building</span>
              <strong data-chapter-signal-value
                >Reliable company intelligence and retail data systems</strong
              >
            </p>
          </div>
          <h2 data-chapter-title>
            Work that turns ambiguity into usable systems.
          </h2>
          <p class="chapter-panel__lead" data-chapter-lead></p>
          <div class="chapter-panel__facts" data-chapter-facts></div>
          <div class="chapter-panel__evidence" data-chapter-evidence></div>
          <div class="chapter-panel__actions" data-chapter-actions></div>
          <button class="portal-button" data-portal-button type="button">
            <span class="portal-button__icon" aria-hidden="true">◎</span>
            <span class="portal-button__copy">
              <span data-portal-action>Enter this place</span>
              <small data-portal-caption>
                Open the working map behind the portfolio
              </small>
            </span>
          </button>

          <section
            class="chapter-panel__inside"
            data-chapter-inside
            aria-labelledby="inside-title"
            hidden
          >
            <div class="chapter-panel__inside-header">
              <div>
                <p data-chapter-inside-kicker>Inside the waystation</p>
                <h3 id="inside-title" data-chapter-inside-title>
                  A live map of what Bongo is building now.
                </h3>
              </div>
              <p
                class="chapter-panel__inside-summary"
                data-chapter-inside-summary
              >
              </p>
            </div>
            <div
              class="chapter-panel__tabs"
              data-chapter-tabs
              role="tablist"
              aria-label="Inside this place"
            >
            </div>
            <div
              class="chapter-panel__tab-panel"
              id="inside-panel"
              data-chapter-tab-panel
              role="tabpanel"
              tabindex="0"
            >
            </div>
            <a
              class="chapter-panel__artifact"
              data-chapter-artifact
              href={sitePath("work/")}
            >
              <span>Recommended route</span>
              <strong>Systems, research and professional record</strong>
              <small>Continue into the complete evidence.</small>
              <b aria-hidden="true">↗</b>
            </a>
          </section>
        </main>

        <figure
          class="companion"
          data-companion
          data-guide-contract="full-body companion"
          aria-labelledby="companion-name"
        >
          <div class="companion__plate" aria-hidden="true"></div>
          <div class="companion__rim" aria-hidden="true"></div>
          <div class="companion__aura" aria-hidden="true"></div>
          <div class="companion__ground" aria-hidden="true"></div>
          <img
            data-companion-image
            src={sitePath("assets/immersive/characters/amani-idle.webp")}
            alt="Amani, a full-body Anzania expedition guide in layered amber and teal fieldwear."
            width="640"
            height="960"
            decoding="async"
          />
          <figcaption>
            <span class="companion__role">YOUR GUIDE</span>
            <strong id="companion-name" data-companion-name>Amani</strong>
            <span class="companion__specialty" data-guide-specialty
              >Systems pathfinder</span
            >
            <span class="companion__temperament" data-guide-temperament
              >Measured and resolute</span
            >
          </figcaption>
          <blockquote class="companion__insight" data-guide-insight>
            Begin with the system, then follow the evidence that makes it real.
          </blockquote>
        </figure>

        <section
          class="ability-dock"
          data-ability-dock
          aria-labelledby="ability-dock-title"
        >
          <header class="ability-dock__header">
            <p id="ability-dock-title">Choose how you cross</p>
            <span data-selected-ability-name>Sandfold</span>
          </header>
          <div class="ability-dock__list" data-ability-list></div>
        </section>

        <div class="look-control">
          <button
            data-look-back-button
            type="button"
            aria-label="Press and hold this button, or hold L, to look back"
            aria-keyshortcuts="L"
            aria-pressed="false"
          >
            <span class="look-control__icon" aria-hidden="true">↶</span>
            <span>Hold button or L to look back</span>
          </button>
        </div>

        <p class="scene-view-status" data-scene-view-status aria-hidden="true">
          Viewing the scene <span aria-hidden="true">·</span> Release to return
        </p>

        <div class="traversal-controls" aria-label="Travel between locations">
          <button
            data-previous-location
            type="button"
            aria-label="Travel to previous location"
          >
            <span aria-hidden="true">←</span>
            <span class="traversal-controls__copy">Previous</span>
          </button>
          <div class="traversal-controls__sigil" aria-hidden="true">
            <span></span>
          </div>
          <button
            data-next-location
            type="button"
            aria-label="Travel to next location"
          >
            <span class="traversal-controls__copy">Next crossing</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <p class="mode-indicator" data-mode-indicator>
          <span aria-hidden="true"></span>
          <b data-mode-copy>Outer approach</b>
        </p>
      </div>

      <dialog
        class="explore-dialog map-dialog"
        data-map-dialog
        aria-labelledby="map-dialog-title"
      >
        <div class="explore-dialog__frame">
          <header class="explore-dialog__header">
            <div>
              <p class="dialog-kicker">
                Eight locations · one professional story
              </p>
              <h2 id="map-dialog-title">Atlas of Anzania</h2>
              <p>
                Eight locations map the work, learning, systems and purpose as
                one guided narrative.
              </p>
            </div>
            <button
              class="dialog-close"
              type="button"
              data-close-dialog
              aria-label="Close atlas"
            >
              ×
            </button>
          </header>
          <div class="map-dialog__body">
            <div
              class="map-dialog__art"
              role="group"
              aria-label="Interactive route atlas"
              aria-describedby="map-dialog-route-note"
            >
              <div class="map-dialog__terrain" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
              </div>
              <div class="map-dialog__route" aria-hidden="true">
                <span class="map-dialog__route-segment"></span>
                <span class="map-dialog__route-segment"></span>
                <span class="map-dialog__route-segment"></span>
                <span class="map-dialog__route-segment"></span>
                <span class="map-dialog__route-segment"></span>
                <span class="map-dialog__route-segment"></span>
                <span class="map-dialog__route-segment"></span>
              </div>
              <div class="map-dialog__atlas-title" aria-hidden="true">
                <span>Anzania route &middot; 01&ndash;08</span>
                <strong>The evidence trail</strong>
              </div>
              <ol
                class="map-dialog__locations"
                data-map-location-list
                aria-label="Choose one of the eight Anzania waystations"
              >
              </ol>
              <div class="map-dialog__legend" aria-hidden="true">
                <span><i></i>Current</span>
                <span><i></i>Visited</span>
                <span><i></i>Ahead</span>
              </div>
              <p class="map-dialog__atlas-note" id="map-dialog-route-note">
                Select any waystation to travel there. Waystations you have
                visited are marked on the route.
              </p>
            </div>
          </div>
        </div>
      </dialog>

      <dialog
        class="explore-dialog guide-dialog"
        data-guide-dialog
        aria-labelledby="guide-dialog-title"
      >
        <div class="explore-dialog__frame">
          <header class="explore-dialog__header">
            <div>
              <p class="dialog-kicker">
                Twelve illustrated companions &middot; distinct points of view
              </p>
              <h2 id="guide-dialog-title">Choose your guide</h2>
              <p>
                Choose the role, temperament and perspective you want beside
                you. Each companion responds differently as the journey moves
                from current work to evidence, craft and what comes next.
              </p>
            </div>
            <button
              class="dialog-close"
              type="button"
              data-close-dialog
              aria-label="Close companion selection"
            >
              ×
            </button>
          </header>
          <div class="guide-dialog__grid" data-guide-grid></div>
        </div>
      </dialog>

      <dialog
        class="explore-dialog options-dialog"
        data-options-dialog
        aria-labelledby="options-dialog-title"
      >
        <div class="explore-dialog__frame explore-dialog__frame--compact">
          <header class="explore-dialog__header">
            <div>
              <p class="dialog-kicker">Make the journey yours</p>
              <h2 id="options-dialog-title">Experience options</h2>
            </div>
            <button
              class="dialog-close"
              type="button"
              data-close-dialog
              aria-label="Close options"
            >
              ×
            </button>
          </header>
          <div class="options-list">
            <label class="option-row">
              <span>
                <strong>Atmospheric motion</strong>
                <small>
                  Pointer-responsive sand, water, fire, parallax and authored
                  traversal effects.
                </small>
              </span>
              <input data-motion-toggle type="checkbox" checked />
            </label>
            <label class="option-row">
              <span>
                <strong>Ambient soundscape</strong>
                <small>Reserved for a future rights-cleared audio layer.</small>
              </span>
              <input type="checkbox" disabled />
            </label>
            <div class="option-row option-row--stacked">
              <span>
                <strong>Keyboard controls</strong>
                <small>
                  Left / right travel · Enter opens a place · M atlas · G guide
                  · hold V view scene · hold L look back · Esc close
                </small>
              </span>
            </div>
            <a class="option-static-link" href={sitePath("")}>
              Return to the complete Static View portfolio <span
                aria-hidden="true">→</span
              >
            </a>
          </div>
        </div>
      </dialog>

      <div
        class="experience-toast"
        data-experience-toast
        role="status"
        aria-live="polite"
      >
      </div>
      <div
        class="experience-announcer visually-hidden"
        data-experience-announcer
        aria-live="polite"
      >
      </div>
    </div>

    <noscript>
      <section class="noscript-fallback">
        <h1>
          Bongo Seakhoa's portfolio remains fully available in Static View.
        </h1>
        <a href={sitePath("")}>Open Static View</a>
      </section>
    </noscript>

    <script
      is:inline
      type="module"
      src={sitePath("assets/immersive/anzania-explorer.js")}></script>
  </body>
</html>
