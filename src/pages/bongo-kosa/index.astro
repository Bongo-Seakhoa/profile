---
import ContentStyles from "../../components/content/ContentStyles.astro";
import ProjectCard from "../../components/content/ProjectCard.astro";
import ActionLink from "../../components/primitives/ActionLink.astro";
import Container from "../../components/primitives/Container.astro";
import PageMasthead from "../../components/primitives/PageMasthead.astro";
import SectionIntro from "../../components/primitives/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadProfileContent } from "../../lib/content/load-content";

const content = await loadProfileContent();
const identity = content.identity[0];
const displayName = identity?.alternateNames[0];
const route = content.routes.find((entry) => entry.id === "bongo-kosa");
const documentsRoute = content.routes.find(
  (entry) => entry.id === "documents-bongo-kosa",
);
const canonicalRoute = content.routes.find(
  (entry) => entry.id === route?.canonicalRouteId,
);

if (!identity || !displayName || !route || !documentsRoute || !canonicalRoute) {
  throw new Error("Bongo Kosa profile content is missing.");
}

const [leadProject, ...supportingProjects] = content.projects
  .filter((project) => project.featured)
  .sort(
    (left, right) =>
      (left.featuredOrder ?? Number.MAX_SAFE_INTEGER) -
      (right.featuredOrder ?? Number.MAX_SAFE_INTEGER),
  );
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={canonicalRoute.path}
  activeRouteId="home"
  updatedDate={identity.lastReviewed}
  profileDisplay={{
    name: displayName,
    homePath: route.path,
    documentsPath: documentsRoute.path,
  }}
>
  <ContentStyles />
  <PageMasthead
    slot="masthead"
    eyebrow={identity.headline}
    title={displayName}
    lede={identity.valueStatement}
  >
    <ActionLink href="#kosa-work">Selected work</ActionLink>
    <ActionLink href={documentsRoute.path} variant="secondary">
      Resume and CV
    </ActionLink>
    <ActionLink href="contact/" variant="secondary">Contact</ActionLink>
  </PageMasthead>

  <section class="page-section" aria-labelledby="kosa-work">
    <Container>
      <SectionIntro id="kosa-work" title="Selected work" />
      <div class="selected-work">
        {leadProject && <ProjectCard project={leadProject} variant="lead" />}
        <div class="supporting-work">
          {
            supportingProjects.map((project) => (
              <ProjectCard project={project} />
            ))
          }
        </div>
      </div>
      <div class="work-links">
        <ActionLink href="work/" variant="secondary">All projects</ActionLink>
        <ActionLink href="experience/" variant="secondary"
          >Experience</ActionLink
        >
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .selected-work,
  .supporting-work {
    display: grid;
    gap: var(--space-5);
  }

  .selected-work {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  }

  .work-links {
    display: flex;
    margin-block-start: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 48rem) {
    .selected-work {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
