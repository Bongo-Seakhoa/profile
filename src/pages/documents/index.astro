---
import ContentStyles from "../../components/content/ContentStyles.astro";
import DocumentCard from "../../components/content/DocumentCard.astro";
import Container from "../../components/primitives/Container.astro";
import PageMasthead from "../../components/primitives/PageMasthead.astro";
import SectionIntro from "../../components/primitives/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadProfileContent } from "../../lib/content/load-content";

const content = await loadProfileContent();
const route = content.routes.find((entry) => entry.id === "documents");

if (!route) throw new Error("Documents route content is missing.");

const cards = content.documentManifest.flatMap((document) =>
  document.variants.map((variant) => ({
    id: variant.id,
    label: `${variant.displayName} ${document.id === "cv" ? "CV" : "Resume"}`,
    description:
      document.id === "resume"
        ? "A concise professional summary with selected experience, projects, education and credentials."
        : "A fuller professional profile with complete experience, selected projects, education and credential history.",
    previewPath: variant.previewPath,
    pdfPath: variant.pdfPath,
    pageCount: document.pageCount,
    identity: variant.displayName,
    kind: document.id,
  })),
);
const primaryCards = cards.filter((card) => card.identity === "Bongo Seakhoa");
const alternateCards = cards.filter((card) => card.identity === "Bongo Kosa");
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  activeRouteId={route.id}
>
  <ContentStyles />
  <PageMasthead
    slot="masthead"
    eyebrow="Professional documents"
    title={route.title}
    lede="Choose a concise two-page resume or a fuller three-page CV, each available under both professional name variants."
  />

  <section class="page-section" aria-labelledby="primary-documents-title">
    <Container>
      <SectionIntro
        id="primary-documents-title"
        eyebrow="Primary identity"
        title="Bongo Seakhoa documents"
        description="Choose the concise resume or the fuller CV. Both are browser-readable and available as direct PDF downloads."
      />
      <div class="documents-grid">
        {
          primaryCards.map((card) => (
            <DocumentCard
              label={card.label}
              description={card.description}
              previewPath={card.previewPath}
              pdfPath={card.pdfPath}
              pageCount={card.pageCount}
              primary
            />
          ))
        }
      </div>
    </Container>
  </section>

  <section
    class="page-section page-section--surface"
    aria-labelledby="alternate-documents-title"
  >
    <Container>
      <SectionIntro
        id="alternate-documents-title"
        eyebrow="Alternate public name"
        title="Bongo Kosa document variants"
        description="These versions present the same career history under Bongo Kosa, an alternate professional and legal name."
      />
      <div class="documents-grid">
        {
          alternateCards.map((card) => (
            <DocumentCard
              label={card.label}
              description={card.description}
              previewPath={card.previewPath}
              pdfPath={card.pdfPath}
              pageCount={card.pageCount}
            />
          ))
        }
      </div>
    </Container>
  </section>

  <section
    class="page-section page-section--muted"
    aria-labelledby="document-access-title"
  >
    <Container size="content">
      <div class="integrity-note">
        <h2 id="document-access-title">Ready to review</h2>
        <p>
          Every document opens as a browser-readable preview and a direct A4 PDF
          download, making it easy to review online or share with a hiring team.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .documents-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 44rem) {
    .documents-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
