---
import ContentStyles from "../../components/content/ContentStyles.astro";
import CredentialRecord from "../../components/content/CredentialRecord.astro";
import ActionLink from "../../components/primitives/ActionLink.astro";
import Container from "../../components/primitives/Container.astro";
import PageMasthead from "../../components/primitives/PageMasthead.astro";
import SectionIntro from "../../components/primitives/SectionIntro.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadProfileContent } from "../../lib/content/load-content";

const content = await loadProfileContent();
const route = content.routes.find((entry) => entry.id === "credentials");

if (!route) throw new Error("Credentials route content is missing.");

const groups = [
  {
    id: "current-cloud",
    eyebrow: "Current cloud",
    title: "Active certifications",
    description: "Current status, expiry and verification are shown directly.",
  },
  {
    id: "professional",
    eyebrow: "Professional learning",
    title: "Certificates and specializations",
    description: "Completed professional programmes with public evidence.",
  },
  {
    id: "academic-coursework",
    eyebrow: "Academic coursework",
    title: "Selected university-level courses",
    description:
      "The statistical inference specialization contains its component courses once, avoiding duplicate display.",
  },
  {
    id: "additional-learning",
    eyebrow: "Additional learning",
    title: "Focused technical courses",
    description: "Shorter completed courses retained as supporting evidence.",
  },
] as const;
const historical = content.credentials.filter(
  (credential) => credential.category === "history",
);
---

<BaseLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.path}
  activeRouteId={route.id}
>
  <ContentStyles />
  <PageMasthead
    slot="masthead"
    eyebrow="Verified learning"
    title={route.title}
    lede="Current cloud credentials, completed professional programmes, academic coursework and clearly labelled credential history."
  >
    <ActionLink href="documents/">Resume and CV</ActionLink>
    <ActionLink href="education/" variant="secondary">
      Formal education
    </ActionLink>
  </PageMasthead>

  {
    groups.map((group, index) => {
      const credentials = content.credentials.filter(
        (credential) => credential.category === group.id,
      );
      return (
        <section
          class:list={[
            "page-section",
            index % 2 === 1 && "page-section--surface",
          ]}
          aria-labelledby={`${group.id}-title`}
        >
          <Container>
            <SectionIntro
              id={`${group.id}-title`}
              eyebrow={group.eyebrow}
              title={group.title}
              description={group.description}
            />
            <div class="credential-list">
              {credentials.map((credential) => (
                <CredentialRecord credential={credential} />
              ))}
            </div>
          </Container>
        </section>
      );
    })
  }

  <section
    class="page-section page-section--muted"
    aria-labelledby="credential-history-title"
  >
    <Container>
      <details class="credential-history">
        <summary id="credential-history-title">Credential history</summary>
        <p>
          Historical credentials remain available for accuracy but are not
          presented as current.
        </p>
        <div class="credential-list">
          {
            historical.map((credential) => (
              <CredentialRecord credential={credential} />
            ))
          }
        </div>
      </details>
    </Container>
  </section>
</BaseLayout>

<style>
  .credential-list {
    display: grid;
  }

  .credential-history {
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .credential-history > summary {
    min-block-size: var(--target-size);
    padding: var(--space-5);
    color: var(--indigo);
    cursor: pointer;
    font-size: var(--step-2);
    font-weight: 700;
  }

  .credential-history > p {
    max-inline-size: 62ch;
    padding: 0 var(--space-5) var(--space-4);
    color: var(--ink-soft);
  }
</style>
