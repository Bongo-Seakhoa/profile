---
import type {
  AnzaniaApprovedUse,
  PublishedAnzaniaPlateId,
} from "@/data/static-art";

import AnzaniaPlate from "./AnzaniaPlate.astro";

type Veil = "copy-left" | "balanced" | "quiet";

interface Props {
  id: PublishedAnzaniaPlateId;
  use: AnzaniaApprovedUse;
  class?: string;
  veil?: Veil;
  priority?: boolean;
  preload?: boolean;
  loading?: "eager" | "lazy";
}

const {
  id,
  use: approvedUse,
  class: className,
  veil = "balanced",
  priority = false,
  preload = priority,
  loading = priority || preload ? "eager" : "lazy",
} = Astro.props;
---

<div
  class:list={["anzania-backdrop", `anzania-backdrop--${veil}`, className]}
  data-anzania-backdrop={id}
  data-anzania-presentation="environmental-background"
  data-anzania-overlay="translucent-white"
  aria-hidden="true"
>
  <AnzaniaPlate
    id={id}
    use={approvedUse}
    decorative
    priority={priority}
    preload={preload}
    loading={loading}
    sizes="100vw"
    fit="cover"
  />
</div>

<style>
  .anzania-backdrop {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    background: var(--surface-muted);
    pointer-events: none;
  }

  .anzania-backdrop :global(.anzania-plate) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    max-inline-size: none;
    block-size: 100%;
  }

  .anzania-backdrop :global(.anzania-plate__image) {
    filter: saturate(0.8) contrast(0.93);
  }

  .anzania-backdrop::before,
  .anzania-backdrop::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    content: "";
  }

  .anzania-backdrop--copy-left::before {
    background:
      linear-gradient(
        90deg,
        rgb(255 253 248 / 96%) 0%,
        rgb(255 253 248 / 91%) 38%,
        rgb(255 253 248 / 68%) 72%,
        rgb(255 253 248 / 74%) 100%
      ),
      linear-gradient(rgb(255 253 248 / 20%), rgb(255 253 248 / 38%));
  }

  .anzania-backdrop--balanced::before {
    background: linear-gradient(
      125deg,
      rgb(255 253 248 / 91%) 0%,
      rgb(255 253 248 / 84%) 52%,
      rgb(255 253 248 / 89%) 100%
    );
  }

  .anzania-backdrop--quiet::before {
    background: linear-gradient(
      100deg,
      rgb(255 253 248 / 94%) 0%,
      rgb(255 253 248 / 86%) 55%,
      rgb(255 253 248 / 78%) 100%
    );
  }

  .anzania-backdrop::after {
    background:
      var(--gold-texture) 0 0 / 100% 0.2rem no-repeat,
      repeating-linear-gradient(
        118deg,
        transparent 0 3.5rem,
        rgb(128 96 32 / 7%) 3.5rem calc(3.5rem + 1px)
      );
  }

  @media (max-width: 48rem) {
    .anzania-backdrop--copy-left::before,
    .anzania-backdrop--balanced::before,
    .anzania-backdrop--quiet::before {
      background: linear-gradient(
        150deg,
        rgb(255 253 248 / 94%) 0%,
        rgb(255 253 248 / 86%) 100%
      );
    }

    .anzania-backdrop::after {
      background:
        var(--gold-texture) 0 0 / 100% 0.18rem no-repeat,
        repeating-linear-gradient(
          118deg,
          transparent 0 5rem,
          rgb(128 96 32 / 5%) 5rem calc(5rem + 1px)
        );
    }
  }

  @media (forced-colors: active) {
    .anzania-backdrop {
      display: none;
    }
  }
</style>
