---
import { isCurrentPath, sitePath } from "../../lib/urls";
import Container from "../primitives/Container.astro";

export interface NavigationItem {
  id: string;
  path: string;
  label: string;
}

export interface DocumentDownload {
  label: string;
  path: string;
}

export interface Props {
  primaryName: string;
  headline: string;
  navigation: NavigationItem[];
  currentPath: string;
  activeRouteId?: string;
  documentsPath?: string;
  documentDownloads?: DocumentDownload[];
  showExploreAnzania?: boolean;
  exploreAnzaniaPath?: string;
}

const {
  primaryName,
  headline,
  navigation,
  currentPath,
  activeRouteId,
  documentsPath = "documents/",
  documentDownloads = [],
  showExploreAnzania = false,
  exploreAnzaniaPath = "explore/",
} = Astro.props;

function isActive(item: NavigationItem): boolean {
  return activeRouteId
    ? item.id === activeRouteId
    : isCurrentPath(currentPath, item.path);
}
---

<header class="site-header">
  <div class="site-header__identity-bar">
    <Container size="wide" class="site-header__identity-inner">
      <a class="site-header__brand" href={sitePath("")}>
        <span class="site-header__wordmark">{primaryName}</span>
        <span class="site-header__descriptor">{headline}</span>
      </a>

      <div class="site-header__utilities">
        <span class="view-indicator" aria-label="Current view: Static View">
          Static View
        </span>
        <details class="header-documents">
          <summary class="header-action">Resume &amp; CV</summary>
          <div class="header-documents__menu">
            <a href={sitePath(documentsPath)}>View all documents</a>
            {
              documentDownloads.map((document) => (
                <a href={sitePath(document.path)} download>
                  {document.label}
                </a>
              ))
            }
          </div>
        </details>
        {
          showExploreAnzania && (
            <a
              class="header-action header-action--accent"
              href={sitePath(exploreAnzaniaPath)}
              aria-describedby="anzania-load-note"
            >
              Explore Anzania
            </a>
          )
        }
      </div>
    </Container>
  </div>

  <div class="site-header__navigation-bar">
    <Container size="wide">
      <nav class="desktop-navigation" aria-label="Primary">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a
                  href={sitePath(item.path)}
                  aria-current={isActive(item) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <details class="mobile-navigation">
        <summary>Menu</summary>
        <nav aria-label="Primary mobile">
          <ul>
            {
              navigation.map((item) => (
                <li>
                  <a
                    href={sitePath(item.path)}
                    aria-current={isActive(item) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="mobile-navigation__action">
              <a href={sitePath(documentsPath)}>View all documents</a>
            </li>
            {
              documentDownloads.map((document) => (
                <li>
                  <a href={sitePath(document.path)} download>
                    {document.label}
                  </a>
                </li>
              ))
            }
            {
              showExploreAnzania && (
                <li class="mobile-navigation__action">
                  <a
                    href={sitePath(exploreAnzaniaPath)}
                    aria-describedby="anzania-load-note"
                  >
                    Explore Anzania
                  </a>
                </li>
              )
            }
          </ul>
        </nav>
      </details>
    </Container>
  </div>

  {
    showExploreAnzania && (
      <p id="anzania-load-note" class="visually-hidden">
        Activating Explore Anzania leaves Static View and loads the optional
        immersive experience.
      </p>
    )
  }
</header>
