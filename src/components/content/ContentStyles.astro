<style is:global>
  .page-section {
    position: relative;
    padding-block: var(--section-space);
  }

  .page-section--surface {
    border-block: 1px solid var(--line);
    background: rgb(251 245 234 / 78%);
    backdrop-filter: blur(0.35rem);
  }

  .page-section--muted {
    border-block: 1px solid var(--line);
    background: rgb(231 215 189 / 74%);
  }

  .page-section--compact {
    padding-block: clamp(2.75rem, 6vw, 5rem);
  }

  .section-actions {
    display: flex;
    margin-block-start: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .section-actions a {
    display: inline-flex;
    min-block-size: var(--target-size);
    padding: 0.65rem 0;
    align-items: center;
    color: var(--rust-strong);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .editorial-grid > * {
    min-inline-size: 0;
  }

  .evidence-band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line-strong);
    background: rgb(251 245 234 / 88%);
    box-shadow: 0 1.2rem 3rem rgb(49 34 21 / 8%);
    backdrop-filter: blur(0.5rem);
  }

  .evidence-band__item {
    position: relative;
    min-block-size: 8.4rem;
    padding: var(--space-5);
    border-inline-start: 1px solid var(--line);
  }

  .evidence-band__item:first-child {
    border-inline-start: 0;
  }

  .evidence-band__item::after {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
    color: rgb(132 63 40 / 28%);
    content: "◇";
    font-family: var(--font-mono);
  }

  .evidence-band__index {
    display: block;
    margin-block-end: var(--space-3);
    color: var(--rust-strong);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .evidence-band__item p {
    max-inline-size: 27ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.48;
  }

  .route-intro-note,
  .empty-state,
  .integrity-note {
    position: relative;
    max-inline-size: 70ch;
    border: 1px solid var(--line-strong);
    background: rgb(251 245 234 / 82%);
    padding: var(--space-5);
  }

  .route-intro-note::before,
  .empty-state::before,
  .integrity-note::before {
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: -1px;
    inline-size: 3.5rem;
    block-size: 2px;
    background: var(--gold);
    content: "";
  }

  .route-intro-note h2,
  .empty-state h2,
  .integrity-note h2 {
    font-size: var(--step-1);
  }

  .route-intro-note p,
  .empty-state p,
  .integrity-note p {
    margin-block-start: var(--space-2);
    color: var(--ink-soft);
  }

  .record-stack {
    display: grid;
    gap: 0;
  }

  .project-archive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .contact-panel {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
    padding: clamp(1.5rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    gap: clamp(2rem, 6vw, 6rem);
    border: 1px solid rgb(237 201 120 / 42%);
    border-radius: 0;
    background:
      linear-gradient(115deg, rgb(34 28 22 / 98%), rgb(39 78 92 / 94%)),
      var(--route-scene);
    background-position: center, center;
    background-size: cover;
    color: var(--surface);
    box-shadow: 0 1.6rem 4rem rgb(32 22 14 / 16%);
  }

  .contact-panel::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(circle at 85% 20%, rgb(237 201 120 / 16%), transparent 34%),
      repeating-linear-gradient(
        90deg,
        transparent 0 4.9rem,
        rgb(255 249 238 / 3%) 4.9rem 5rem
      );
    content: "";
  }

  .contact-panel::after {
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: -1px;
    inline-size: 4.5rem;
    block-size: 2px;
    background: var(--gold-light);
    content: "";
  }

  .contact-panel h2 {
    max-inline-size: 20ch;
    color: inherit;
    font-size: var(--step-3);
  }

  .contact-panel p {
    max-inline-size: 56ch;
    margin-block-start: var(--space-4);
    color: rgb(255 249 238 / 78%);
  }

  .contact-panel__links {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .contact-panel__links a {
    display: flex;
    min-block-size: var(--target-size);
    padding: 0.65rem 0;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-block-end: 1px solid rgb(255 249 238 / 20%);
    color: var(--surface);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .contact-panel__links a::after {
    color: var(--gold-light);
    content: "↗";
  }

  .visually-hidden {
    position: absolute !important;
    inline-size: 1px !important;
    block-size: 1px !important;
    padding: 0 !important;
    overflow: hidden !important;
    border: 0 !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
  }

  @media (max-width: 58rem) {
    .evidence-band {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .evidence-band__item:nth-child(3) {
      border-inline-start: 0;
    }

    .evidence-band__item:nth-child(n + 3) {
      border-block-start: 1px solid var(--line);
    }

    .contact-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .evidence-band,
    .project-archive-grid {
      grid-template-columns: 1fr;
    }

    .evidence-band__item {
      border-block-start: 1px solid var(--line);
      border-inline-start: 0;
    }

    .evidence-band__item:first-child {
      border-block-start: 0;
    }
  }
</style>
