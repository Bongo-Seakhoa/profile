---
import type { Experience } from "../../lib/content/schemas";
import TechnologyList from "./TechnologyList.astro";

export interface Props {
  experience: Experience;
  compact?: boolean;
}

const { experience, compact = false } = Astro.props;
const formatter = new Intl.DateTimeFormat("en-GB", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const formatMonth = (value: string) => {
  const [yearPart, monthPart] = value.split("-");
  const year = Number(yearPart);
  const month = Number(monthPart);
  if (!Number.isInteger(year) || !Number.isInteger(month)) {
    throw new TypeError(`Invalid experience date: ${value}`);
  }
  return formatter.format(new Date(Date.UTC(year, month - 1, 1)));
};
const dateRange = `${formatMonth(experience.dateStart)} to ${
  experience.current
    ? "Present"
    : formatMonth(experience.dateEnd ?? experience.dateStart)
}`;
---

<article
  class:list={["experience-record", compact && "experience-record--compact"]}
  data-record-id={experience.id}
  data-signal-card
>
  <div class="experience-record__marker" aria-hidden="true">
    <span></span>
  </div>
  <div class="experience-record__content">
    <header>
      <div>
        <p class="experience-record__company">{experience.company}</p>
        <h3>{experience.role}</h3>
      </div>
      <dl>
        <div>
          <dt>Dates</dt>
          <dd>{dateRange}</dd>
        </div>
        <div>
          <dt>Context</dt>
          <dd>{experience.remote ? "Remote, " : ""}{experience.location}</dd>
        </div>
      </dl>
    </header>
    <p class="experience-record__summary">{experience.summary}</p>
    {
      !compact && (
        <>
          <ul>
            {experience.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
          <TechnologyList items={experience.tools} label="Tools and focus" />
        </>
      )
    }
  </div>
</article>

<style>
  .experience-record {
    position: relative;
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr);
    gap: var(--space-4);
  }

  .experience-record__marker {
    position: relative;
    border-inline-start: 1px solid var(--line-strong);
  }

  .experience-record__marker span {
    position: absolute;
    inset-block-start: 0.2rem;
    inset-inline-start: -0.43rem;
    inline-size: 0.78rem;
    block-size: 0.78rem;
    border: 2px solid var(--surface);
    background: var(--rust);
    box-shadow: 0 0 0 1px var(--rust);
    transform: rotate(45deg);
  }

  .experience-record__content {
    position: relative;
    min-inline-size: 0;
    padding: 0 0 clamp(2.25rem, 5vw, 4rem);
  }

  .experience-record__content::before {
    position: absolute;
    inset-block-start: -0.05rem;
    inset-inline: 0;
    block-size: 1px;
    background: linear-gradient(90deg, var(--line-strong), transparent 82%);
    content: "";
  }

  header {
    display: grid;
    padding-block-start: var(--space-5);
    grid-template-columns: minmax(0, 1fr) minmax(16rem, auto);
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .experience-record__company {
    margin-block-end: var(--space-1);
    color: var(--rust-strong);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h3 {
    max-inline-size: 24ch;
    font-size: clamp(1.55rem, 2.6vw, 2.75rem);
  }

  dl {
    display: grid;
    margin: 0;
    gap: var(--space-2);
  }

  dl > div {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-2);
  }

  dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 650;
  }

  .experience-record__summary {
    max-inline-size: 72ch;
    margin-block-start: var(--space-4);
    color: var(--ink-soft);
    font-size: 1rem;
  }

  ul {
    display: grid;
    max-inline-size: 72ch;
    margin: var(--space-5) 0;
    padding: 0;
    gap: var(--space-3);
    list-style: none;
  }

  li {
    position: relative;
    padding-inline-start: 1.2rem;
  }

  li::before {
    position: absolute;
    inset-block-start: 0.68em;
    inset-inline-start: 0;
    inline-size: 0.34rem;
    block-size: 0.34rem;
    background: var(--gold);
    content: "";
    transform: rotate(45deg);
  }

  .experience-record--compact .experience-record__content {
    padding-block-end: var(--space-6);
  }

  @media (max-width: 46rem) {
    header {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    dl > div {
      grid-template-columns: 4rem minmax(0, 1fr);
    }
  }
</style>
