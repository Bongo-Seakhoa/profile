---
import type { Experience } from "../../lib/content/schemas";
import TechnologyList from "./TechnologyList.astro";

export interface Props {
  experience: Experience;
  compact?: boolean;
}

const { experience, compact = false } = Astro.props;
const formatter = new Intl.DateTimeFormat("en-GB", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const formatMonth = (value: string) => {
  const [yearPart, monthPart] = value.split("-");
  const year = Number(yearPart);
  const month = Number(monthPart);
  if (!Number.isInteger(year) || !Number.isInteger(month)) {
    throw new TypeError(`Invalid experience date: ${value}`);
  }
  return formatter.format(new Date(Date.UTC(year, month - 1, 1)));
};
const dateRange = `${formatMonth(experience.dateStart)} to ${
  experience.current
    ? "Present"
    : formatMonth(experience.dateEnd ?? experience.dateStart)
}`;
const companyMark = experience.company
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase())
  .join("");
---

<article
  class:list={[
    "experience-record",
    compact && "experience-record--compact",
    experience.current && "experience-record--current",
  ]}
  data-record-id={experience.id}
  data-signal-card
>
  <div class="experience-record__marker" aria-hidden="true">
    <span></span>
  </div>
  <div class="experience-record__content">
    <div class="experience-record__index" aria-hidden="true"></div>
    <header>
      <div class="experience-record__identity">
        <span class="experience-record__company-mark" aria-hidden="true">
          <i>{companyMark}</i>
        </span>
        <div>
          <div class="experience-record__company-line">
            <p class="experience-record__company">{experience.company}</p>
            <span class="experience-record__status">
              {experience.current ? "Current role" : "Completed chapter"}
            </span>
          </div>
          <h3>{experience.role}</h3>
        </div>
      </div>
      <dl>
        <div>
          <dt>Dates</dt>
          <dd>{dateRange}</dd>
        </div>
        <div>
          <dt>Context</dt>
          <dd>{experience.remote ? "Remote, " : ""}{experience.location}</dd>
        </div>
      </dl>
    </header>
    <p class="experience-record__summary">{experience.summary}</p>
    {
      !compact && (
        <>
          <ul class="experience-record__highlights">
            {experience.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
          <div class="experience-record__tools">
            <TechnologyList items={experience.tools} label="Tools and focus" />
          </div>
        </>
      )
    }
  </div>
</article>

<style>
  .experience-record {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    counter-increment: professional-record;
  }

  .experience-record__marker {
    position: relative;
    border-inline-start: 1px solid var(--line-strong);
  }

  .experience-record__marker span {
    position: absolute;
    z-index: 2;
    inset-block-start: 2.4rem;
    inset-inline-start: -0.51rem;
    inline-size: 0.92rem;
    block-size: 0.92rem;
    border: 3px solid var(--surface);
    background: var(--rust);
    box-shadow:
      0 0 0 1px var(--rust),
      0 0.5rem 1.4rem rgb(126 75 45 / 22%);
    transform: rotate(45deg);
  }

  .experience-record--current .experience-record__marker span {
    background: var(--gold);
    box-shadow:
      0 0 0 1px var(--rust),
      0 0 0 0.42rem rgb(211 166 81 / 12%);
  }

  .experience-record__content {
    position: relative;
    min-inline-size: 0;
    margin-block-end: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1.4rem, 3vw, 2.5rem);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(
        circle at var(--signal-x, 91%) var(--signal-y, 8%),
        rgb(211 166 81 / 12%),
        transparent 29%
      ),
      linear-gradient(145deg, rgb(251 245 234 / 94%), rgb(241 229 207 / 78%));
    box-shadow: 0 1.4rem 4.5rem rgb(43 30 19 / 7%);
  }

  .experience-record__content::before {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 0.24rem;
    background: linear-gradient(
      180deg,
      var(--rust),
      var(--gold),
      transparent 88%
    );
    content: "";
  }

  .experience-record__content::after {
    position: absolute;
    z-index: 0;
    inset-inline-end: -4.5rem;
    inset-block-end: -4.5rem;
    inline-size: 9rem;
    block-size: 9rem;
    border: 1px solid rgb(126 75 45 / 13%);
    content: "";
    transform: rotate(45deg);
  }

  .experience-record__index {
    position: absolute;
    z-index: 0;
    inset-block-start: -0.24em;
    inset-inline-end: 0.2em;
    color: rgb(126 75 45 / 5%);
    font-family: var(--font-serif);
    font-size: clamp(5rem, 12vw, 10rem);
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
  }

  .experience-record__index::before {
    content: counter(professional-record, decimal-leading-zero);
  }

  header,
  .experience-record__summary,
  .experience-record__highlights,
  .experience-record__tools {
    position: relative;
    z-index: 1;
  }

  header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, auto);
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .experience-record__identity {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .experience-record__company-mark {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border: 1px solid var(--line-strong);
    color: var(--rust-strong);
    background: rgb(251 245 234 / 74%);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transform: rotate(45deg);
  }

  .experience-record__company-mark i {
    font-style: normal;
    transform: rotate(-45deg);
  }

  .experience-record__company-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .experience-record__company {
    margin: 0;
    color: var(--rust-strong);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .experience-record__status {
    padding: 0.28rem 0.48rem;
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
    background: rgb(251 245 234 / 56%);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .experience-record--current .experience-record__status {
    border-color: rgb(126 75 45 / 34%);
    color: var(--rust-strong);
    background: rgb(211 166 81 / 13%);
  }

  h3 {
    max-inline-size: 25ch;
    margin-block-start: var(--space-2);
    font-size: clamp(1.7rem, 3vw, 3.2rem);
    line-height: 1;
  }

  dl {
    display: grid;
    align-content: start;
    margin: 0;
    padding: var(--space-4);
    gap: var(--space-3);
    border-block: 1px solid var(--line-strong);
    background: rgb(251 245 234 / 42%);
  }

  dl > div {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-2);
  }

  dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 650;
  }

  .experience-record__summary {
    max-inline-size: 76ch;
    margin-block: clamp(1.6rem, 4vw, 3rem) 0;
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--gold);
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.65;
  }

  .experience-record__highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-inline-size: none;
    margin: clamp(1.8rem, 4vw, 3rem) 0;
    padding: 0;
    gap: 1px;
    border: 1px solid var(--line-strong);
    background: var(--line-strong);
    list-style: none;
  }

  .experience-record__highlights li {
    position: relative;
    min-inline-size: 0;
    padding: var(--space-4) var(--space-4) var(--space-4) 2.5rem;
    background: rgb(251 245 234 / 84%);
    line-height: 1.55;
  }

  .experience-record__highlights li::before {
    position: absolute;
    inset-block-start: 1.55rem;
    inset-inline-start: 1.1rem;
    inline-size: 0.38rem;
    block-size: 0.38rem;
    background: var(--gold);
    content: "";
    transform: rotate(45deg);
  }

  .experience-record__tools {
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--line-strong);
  }

  .experience-record--compact .experience-record__content {
    margin-block-end: var(--space-5);
  }

  .experience-record--compact .experience-record__summary {
    margin-block-end: 0;
  }

  @media (max-width: 52rem) {
    header {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .experience-record__highlights {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .experience-record {
      grid-template-columns: 0.9rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .experience-record__content {
      padding: var(--space-5) var(--space-4);
    }

    .experience-record__marker span {
      inset-inline-start: -0.42rem;
      inline-size: 0.72rem;
      block-size: 0.72rem;
    }

    .experience-record__identity {
      grid-template-columns: 2.6rem minmax(0, 1fr);
    }

    .experience-record__company-mark {
      inline-size: 2.6rem;
      block-size: 2.6rem;
    }

    dl {
      grid-template-columns: 1fr;
    }

    .experience-record__status {
      display: none;
    }
  }
</style>
