---
import type { Capability } from "../../lib/content/schemas";
import { sitePath } from "../../lib/urls";
import TechnologyList from "./TechnologyList.astro";

export interface Props {
  capability: Capability;
  index: number;
}

const { capability, index } = Astro.props;
const evidenceHref = (collection: "experience" | "project", id: string) =>
  collection === "project" ? sitePath(`work/${id}/`) : sitePath("experience/");
---

<article class="capability-record" data-record-id={capability.id}>
  <div class="capability-record__index" aria-hidden="true">
    {String(index).padStart(2, "0")}
  </div>
  <div class="capability-record__main">
    <h2>{capability.title}</h2>
    <p class="capability-record__problem">{capability.problem}</p>
    <div class="capability-record__details">
      <div>
        <h3>What I deliver</h3>
        <ul>
          {capability.delivers.map((deliverable) => <li>{deliverable}</li>)}
        </ul>
      </div>
      <div>
        <h3>Selected evidence</h3>
        <ul>
          {
            capability.evidence.map((evidence) => (
              <li>
                <a href={evidenceHref(evidence.collection, evidence.id)}>
                  {evidence.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <TechnologyList items={capability.tools} label="Working toolkit" />
  </div>
</article>

<style>
  .capability-record {
    display: grid;
    padding-block: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(3rem, 0.35fr) minmax(0, 2.65fr);
    gap: clamp(1rem, 4vw, 4rem);
    border-block-start: 1px solid var(--line-strong);
  }

  .capability-record:nth-child(even) {
    background: var(--surface-quiet);
  }

  .capability-record__index {
    color: var(--gold-ink);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: 700;
  }

  .capability-record__main {
    max-inline-size: 64rem;
  }

  h2 {
    max-inline-size: 24ch;
    font-size: var(--step-3);
  }

  .capability-record__problem {
    max-inline-size: 64ch;
    margin-block-start: var(--space-4);
    color: var(--ink-soft);
    font-size: var(--step-1);
  }

  .capability-record__details {
    display: grid;
    margin-block: var(--space-6);
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  h3 {
    margin-block-end: var(--space-3);
    color: var(--indigo);
    font-size: var(--step-0);
  }

  ul {
    display: grid;
    margin: 0;
    padding-inline-start: 1.2rem;
    gap: var(--space-2);
    color: var(--ink-soft);
  }

  li::marker {
    color: var(--gold);
  }

  a {
    color: var(--rust-strong);
    font-weight: 650;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 42rem) {
    .capability-record {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .capability-record__details {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
