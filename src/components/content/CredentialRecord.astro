---
import type { Credential } from "../../lib/content/schemas";
import StatusBadge from "./StatusBadge.astro";

export interface Props {
  credential: Credential;
}

const { credential } = Astro.props;
const tone =
  credential.status === "active"
    ? "active"
    : credential.status === "historical"
      ? "historical"
      : "public";
---

<article
  class="credential-record"
  data-record-id={credential.id}
  data-signal-card
>
  <div class="credential-record__copy">
    <div class="credential-record__status">
      <StatusBadge label={credential.statusLabel} tone={tone} />
      <span>{credential.issuer}</span>
    </div>
    <h3>{credential.title}</h3>
    {
      credential.components.length > 0 && (
        <details>
          <summary>Included coursework</summary>
          <ul>
            {credential.components.map((component) => (
              <li>{component.title}</li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
  <a
    class="credential-record__verify"
    href={credential.verificationUrl}
    target="_blank"
    rel="noreferrer"
  >
    Verify credential
    <span class="visually-hidden">: {credential.title}</span>
  </a>
</article>

<style>
  .credential-record {
    position: relative;
    display: grid;
    min-inline-size: 0;
    padding: clamp(1.35rem, 3vw, 2.2rem);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-5);
    border: 1px solid var(--line-strong);
    background: rgb(251 245 234 / 82%);
  }

  .credential-record::before {
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: -1px;
    inline-size: 4rem;
    block-size: 2px;
    background: var(--gold);
    content: "";
  }

  .credential-record__copy {
    min-inline-size: 0;
  }

  .credential-record__status {
    display: flex;
    margin-block-end: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  h3 {
    max-inline-size: 36ch;
    font-size: clamp(1.35rem, 2.2vw, 2.2rem);
  }

  .credential-record__verify {
    display: inline-flex;
    min-block-size: var(--target-size);
    padding: 0.65rem 0.85rem;
    align-items: center;
    border: 1px solid var(--rust);
    color: var(--rust-strong);
    font-size: 0.78rem;
    font-weight: 750;
    text-decoration: none;
  }

  .credential-record__verify::after {
    margin-inline-start: 0.45rem;
    content: "↗";
    font-family: var(--font-mono);
  }

  .credential-record__verify:hover {
    background: var(--rust);
    color: var(--surface);
  }

  details {
    margin-block-start: var(--space-4);
    color: var(--ink-soft);
  }

  summary {
    min-block-size: var(--target-size);
    padding-block: 0.65rem;
    color: var(--indigo);
    cursor: pointer;
    font-weight: 700;
  }

  ul {
    display: grid;
    margin: var(--space-2) 0 0;
    padding-inline-start: 1.2rem;
    gap: var(--space-2);
  }

  li::marker {
    color: var(--gold);
  }

  @media (max-width: 38rem) {
    .credential-record {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .credential-record__verify {
      justify-self: start;
    }
  }
</style>
