---
import type { Credential } from "../../lib/content/schemas";
import StatusBadge from "./StatusBadge.astro";

export interface Props {
  credential: Credential;
}

const { credential } = Astro.props;
const tone =
  credential.status === "active"
    ? "active"
    : credential.status === "historical"
      ? "historical"
      : "public";
---

<article class="credential-record" data-record-id={credential.id}>
  <div class="credential-record__copy">
    <div class="credential-record__status">
      <StatusBadge label={credential.statusLabel} tone={tone} />
    </div>
    <h3>{credential.title}</h3>
    <p>{credential.issuer}</p>
    {
      credential.components.length > 0 && (
        <details>
          <summary>Included coursework</summary>
          <ul>
            {credential.components.map((component) => (
              <li>{component.title}</li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
  <a
    class="credential-record__verify"
    href={credential.verificationUrl}
    target="_blank"
    rel="noreferrer"
  >
    Verify credential
    <span class="visually-hidden">: {credential.title}</span>
  </a>
</article>

<style>
  .credential-record {
    display: grid;
    min-inline-size: 0;
    padding: var(--space-5);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-5);
    border-block-start: 1px solid var(--line-strong);
  }

  .credential-record__copy {
    min-inline-size: 0;
  }

  .credential-record__status {
    margin-block-end: var(--space-3);
  }

  h3 {
    max-inline-size: 42ch;
    font-size: var(--step-1);
  }

  h3 + p {
    margin-block-start: var(--space-2);
    color: var(--ink-soft);
  }

  .credential-record__verify {
    display: inline-flex;
    min-block-size: var(--target-size);
    padding-block: 0.65rem;
    align-items: center;
    color: var(--rust-strong);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  details {
    margin-block-start: var(--space-4);
    color: var(--ink-soft);
  }

  summary {
    min-block-size: var(--target-size);
    padding-block: 0.65rem;
    color: var(--indigo);
    cursor: pointer;
    font-weight: 700;
  }

  ul {
    margin: var(--space-2) 0 0;
    padding-inline-start: 1.2rem;
  }

  @media (max-width: 38rem) {
    .credential-record {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
