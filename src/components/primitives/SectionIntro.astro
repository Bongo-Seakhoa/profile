---
export interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  headingLevel?: 2 | 3;
  id?: string;
  class?: string;
}

const {
  title,
  eyebrow,
  description,
  headingLevel = 2,
  id,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as "h2" | "h3";
---

<header class:list={["section-intro", className]}>
  {eyebrow && <p class="section-intro__eyebrow">{eyebrow}</p>}
  <Heading id={id}>{title}</Heading>
  {description && <p class="section-intro__description">{description}</p>}
  {
    Astro.slots.has("default") && (
      <div class="section-intro__supplement">
        <slot />
      </div>
    )
  }
</header>
