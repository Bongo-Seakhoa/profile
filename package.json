{
  "name": "bongo-seakhoa-profile",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bongo Seakhoa's production static portfolio and browser-native document pipeline.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:release-assets": "node scripts/build-release-assets.mjs",
    "build:social-cards": "node scripts/build-social-cards.mjs",
    "build:site": "pnpm run build:release-assets && pnpm run build:social-cards && astro build",
    "build:documents": "node scripts/build-documents.mjs",
    "verify:documents": "node scripts/verify-documents.mjs",
    "build:metadata": "node scripts/write-release-metadata.mjs",
    "validate:public": "node scripts/validate-public-output.mjs",
    "validate:release": "node scripts/validate-release-metadata.mjs",
    "validate:budgets": "node scripts/validate-static-budgets.mjs",
    "validate:character-assets": "tsx scripts/validate-character-assets.ts",
    "verify:lighthouse": "node scripts/verify-lighthouse.mjs",
    "build": "pnpm run validate:content && pnpm run validate:character-assets && pnpm run build:site && pnpm run build:documents && pnpm run verify:documents && pnpm run build:metadata && pnpm run validate:public && pnpm run validate:release && pnpm run validate:budgets",
    "check": "astro check && tsc --noEmit",
    "lint": "node scripts/run-eslint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run tests/unit",
    "test:camera": "vitest run tests/unit/immersive/full-body-camera.test.ts",
    "test:animation": "vitest run tests/unit/immersive/animation-runtime.test.ts",
    "test:immersive": "vitest run tests/unit/immersive",
    "test:e2e": "playwright test",
    "test": "pnpm run test:unit && pnpm run build && pnpm run test:e2e",
    "qa": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test && pnpm run verify:lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "6.4.8",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "lighthouse": "13.3.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  }
}
